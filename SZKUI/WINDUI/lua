        local item = {Instance = frame, Button = btn, Label = lbl, Icon = groupIcon, Arrow = arrow, Tabs = {}, Expanded = true}
        function item:SetExpanded(v)
            item.Expanded = v == true
            tween(arrow, 0.3, {Rotation = item.Expanded and 0 or 180}, Enum.EasingStyle.Quint)
            for _, tab in ipairs(item.Tabs) do
                if item.Expanded then
                    tab.Button.Visible = true
                    tab.Button.Size = UDim2.new(1, 0, 0, 0)
