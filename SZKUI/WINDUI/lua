        button.MouseEnter:Connect(function()
            if not page.Visible then tw(button, 0.14, {BackgroundTransparency = 0.94, BackgroundColor3 = theme.Surface}) end
        end)
        button.MouseLeave:Connect(function()
            if not page.Visible then tw(button, 0.14, {BackgroundTransparency = 1, BackgroundColor3 = theme.Accent}) end
        end)

        function tab:UpdateTheme(nt)
            button.BackgroundColor3 = nt.Accent
            page.ScrollBarImageColor3 = nt.Accent
