            local hit = mk("TextButton", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, -10),
                Size = UDim2.new(1, 0, 1, 20),
                Text = "",
                ZIndex = 9,
            }, tr)
            local function set(v, fire)
                value = math.clamp(v, min, max)
                local p = (value - min) / math.max(max - min, 1)
                fill.Size = UDim2.new(p, 0, 1, 0)
                knob.Position = UDim2.new(p, 0, 0.5, 0)
                vL.Text = tostring(math.floor(value * 100) / 100)
                if fire and c.Callback then task.spawn(c.Callback, value) end
            end
            local sliding = false
            hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    local p = math.clamp((input.Position.X - tr.AbsolutePosition.X) / math.max(tr.AbsoluteSize.X, 1), 0, 1)
                    set(min + (max - min) * p, true)
                end
            end)
            UIS.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local p = math.clamp((input.Position.X - tr.AbsolutePosition.X) / math.max(tr.AbsoluteSize.X, 1), 0, 1)
                    set(min + (max - min) * p, true)
                end
            end)
            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = false end
            end)
            local item = {Instance = f}
            function item:Set(v) set(tonumber(v) or value, true) end
            function item:Get() return value end
            function item:UpdateTheme(t)
