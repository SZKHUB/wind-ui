function Window:_setupDrag(handle, target, centerBtn, minBtn, closeBtn)
    local dragging, dragStart, startX, startY = false, nil, 0, 0

    local function isBtn(obj)
        if not obj then return false end
        return obj == centerBtn or obj == minBtn or obj == closeBtn
            or obj:IsDescendantOf(centerBtn)
            or obj:IsDescendantOf(minBtn)
            or obj:IsDescendantOf(closeBtn)
    end

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if input.Target and isBtn(input.Target) then return end
            dragging = true
            dragStart = input.Position
            startX = target.Position.X.Offset
            startY = target.Position.Y.Offset
        end
    end)

    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(
                target.Position.X.Scale, startX + delta.X,
                target.Position.Y.Scale, startY + delta.Y
            )
        end
    end)
end

function Window:_setupBall(ball, target)
    local dragging, dragStart, startX, startY = false, nil, 0, 0
    local moved, pressTime = false, 0

    ball.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            pressTime = tick()
            dragStart = input.Position
            startX = ball.Position.X.Offset
            startY = ball.Position.Y.Offset

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if not moved and (tick() - pressTime) < 0.5 then
                        self:SetOpen(true)
                    end
                    moved = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
                moved = true
            end
            ball.Position = UDim2.new(
                ball.Position.X.Scale, startX + delta.X,
                ball.Position.Y.Scale, startY + delta.Y
            )
        end
    end)
end

function Window:SetOpen(state)
    if self.WindowOpen == state then return end
    self.WindowOpen = state

    if state then
        self.Main.Visible = true
        self.Main.Position = UDim2.new(
            self.HomePos.X.Scale, self.HomePos.X.Offset,
            self.HomePos.Y.Scale, self.HomePos.Y.Offset + 30
        )
        self.Main.Size = UDim2.new(0, self.WindowSize.X.Offset * 0.9, 0, self.WindowSize.Y.Offset * 0.9)

        TweenService:Create(self.Main, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = self.HomePos,
            Size = self.WindowSize,
        }):Play()

        self.Ball.Visible = false
    else
        TweenService:Create(self.Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, self.WindowSize.X.Offset * 0.85, 0, self.WindowSize.Y.Offset * 0.85),
        }):Play()

        task.delay(0.2, function()
            self.Main.Visible = false
            self.Ball.Visible = true
        end)
    end
end

function Window:Toggle()
    self:SetOpen(not self.WindowOpen)
end

