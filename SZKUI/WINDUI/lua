    "https://raw.githubusercontent.com/ONYXHUB-X-SZK/SZKICONS3/refs/heads/main/SZK/ICONS4",
}

function FluxesUI:LoadAllIcons()
    local master = {}
    local loadedCount = 0
    for _, url in ipairs(IconSources) do
        local success, chunk = pcall(function()
            return game:HttpGet(url)
        end)
        if success and chunk and #chunk > 10 then
            local fn = loadstring(chunk)
            if fn then
                local ok, tbl = pcall(fn)
                if ok and type(tbl) == "table" then
                    for k, v in pairs(tbl) do master[k] = v end
                    loadedCount = loadedCount + 1
                end
            end
        end
    end
    self.Icons = master
    return loadedCount
end

function FluxesUI:GetIcon(name)
    if not name then return nil end
    if type(name) == "string" and name:find("rbxassetid://") then
        return name
    end
    return self.Icons[name] or nil
end

