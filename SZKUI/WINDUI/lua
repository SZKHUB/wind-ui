local function make(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do pcall(function() o[k] = v end) end
    if parent then o.Parent = parent end
    return o
end
local function corner(parent, radius)
    return make("UICorner", {CornerRadius = UDim.new(0, radius or 10)}, parent)
end
local function stroke(parent, color, transparency, thickness)
    return make("UIStroke", {
        Color = color or Color3.new(1,1,1),
        Transparency = transparency or 0.7,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end
local function pad(parent, l, r, t, b)
    return make("UIPadding", {
        PaddingLeft = UDim.new(0, l or 10),
        PaddingRight = UDim.new(0, r or l or 10),
        PaddingTop = UDim.new(0, t or 8),
        PaddingBottom = UDim.new(0, b or t or 8),
    }, parent)
end
local function tween(obj, time, props, style, direction)
    local ti = TweenInfo.new(
        math.max(0.08, time or 0.22),
        style or Enum.EasingStyle.Quint,
        direction or Enum.EasingDirection.Out
    )
    local t = TweenService:Create(obj, ti, props)
    t:Play()
    return t
end
-- Soft outer glow via multiple UIStrokes
local function glow(parent, color, baseTransparency, maxThickness)
    color = color or Color3.new(0,0,0)
    baseTransparency = baseTransparency or 0.85
    maxThickness = maxThickness or 10
    local layers = 4
    local strokes = {}
    for i = 1, layers do
        local s = make("UIStroke", {
            Color = color,
            Transparency = math.clamp(baseTransparency + (i-1) * 0.04, 0, 1),
            Thickness = maxThickness * (i / layers),
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, parent)
        table.insert(strokes, s)
    end
    return strokes
end
-- Material-style ripple on click
local function attachRipple(button, color)
    local function spawnRipple(x, y)
        local rip = make("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(x, y),
            Size = UDim2.fromOffset(0, 0),
            BackgroundColor3 = color or Color3.new(1,1,1),
            BackgroundTransparency = 0.55,
            BorderSizePixel = 0,
            ZIndex = 90,
        }, button)
        corner(rip, 999)
        tween(rip, 0.55, {
            Size = UDim2.fromOffset(140, 140),
            BackgroundTransparency = 1,
        }, Enum.EasingStyle.Quart)
        task.delay(0.6, function() if rip.Parent then rip:Destroy() end end)
    end
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local rel = input.Position - button.AbsolutePosition
            spawnRipple(rel.X, rel.Y)
        end
    end)
end
-- Hover scale effect
local function attachHoverScale(obj, scale, time)
    scale = scale or 1.03
    time = time or 0.18
    local baseSize = obj.Size
    obj.MouseEnter:Connect(function()
        tween(obj, time, {Size = UDim2.new(baseSize.X.Scale * scale, baseSize.X.Offset * scale, baseSize.Y.Scale * scale, baseSize.Y.Offset * scale)}, Enum.EasingStyle.Quint)
    end)
    obj.MouseLeave:Connect(function()
        tween(obj, time, {Size = baseSize}, Enum.EasingStyle.Quint)
    end)
end
local function assetId(value)
    if typeof(value) == "number" then return "rbxassetid://" .. value end
    if typeof(value) ~= "string" then return "" end
    if value == "" then return "" end
    if value:match("^rbxassetid://") or value:match("^https?://") then return value end
    if value:match("^%d+$") then return "rbxassetid://" .. value end
    local icon = OpenHubUI:GetIcon(value)
    if icon then return icon end
    return value
end
local function resolveAsset(path)
    if typeof(path) ~= "string" then return nil end
    if path:match("^rbxassetid://") or path:match("^https?://") then return path end
    if getsynasset then local ok, r = pcall(getsynasset, path); if ok and r and r ~= "" then return r end end
    if getcustomasset then local ok, r = pcall(getcustomasset, path); if ok and r and r ~= "" then return r end end
    if getcustomassetmacked then local ok, r = pcall(getcustomassetmacked, path); if ok and r and r ~= "" then return r end end
    return nil
end
local function downloadAsset(path)
    if typeof(path) ~= "string" or not path:match("^https?://") then return nil end
    local data
    local rf = request or http_request or (syn and syn.request)
    if rf then
        local ok, r = pcall(rf, {Url = path, Method = "GET"})
        if ok and type(r) == "table" and (r.Success == nil or r.Success) then data = r.Body end
    end
    if not data and game and game.HttpGet then
        local ok, r = pcall(function() return game:HttpGet(path) end)
        if ok then data = r end
    end
    if not data or not writefile then return nil end
    local ext = path:match("%.([%a%d]+)") or "jpg"
    ext = ext:lower()
    if ext ~= "png" and ext ~= "jpg" and ext ~= "jpeg" and ext ~= "gif" and ext ~= "webp" then ext = "jpg" end
    local filename = "OpenHubUI_" .. HttpService:GenerateGUID(false):gsub("-", "") .. "." .. ext
    local ok = pcall(writefile, filename, data)
    if not ok then return nil end
    return resolveAsset(filename)
end
local function loadLocalImage(path, data)
    if typeof(path) == "number" then return assetId(path) end
    if typeof(path) ~= "string" then return "" end
    if path:match("^https?://") then return downloadAsset(path) or path end
    if path:match("^rbxassetid://") then return path end
    if path:match("%.png$") or path:match("%.jpg$") or path:match("%.jpeg$") or path:match("%.gif$") then
        if data and writefile then pcall(writefile, path, data) end
        local r = resolveAsset(path)
        if r then return r end
    end
    return assetId(path)
end
local function deepCopy(s) local o = {}; for k,v in pairs(s) do o[k] = v end; return o end
local function normalizeColor(value, fallback)
    if typeof(value) == "Color3" then return value end
    if type(value) == "table" then
        local r = tonumber(value.R or value[1]); local g = tonumber(value.G or value[2]); local b = tonumber(value.B or value[3])
        if r and g and b then
            if r <= 1 and g <= 1 and b <= 1 then
                return Color3.new(math.clamp(r,0,1), math.clamp(g,0,1), math.clamp(b,0,1))
            end
            return Color3.fromRGB(math.clamp(r,0,255), math.clamp(g,0,255), math.clamp(b,0,255))
        end
    end
    if type(value) == "string" then
        local hex = value:gsub("#",""):gsub("%s","")
        if #hex == 6 then
            local r = tonumber(hex:sub(1,2),16); local g = tonumber(hex:sub(3,4),16); local b = tonumber(hex:sub(5,6),16)
            if r and g and b then return Color3.fromRGB(r,g,b) end
        end
    end
    return fallback
end

