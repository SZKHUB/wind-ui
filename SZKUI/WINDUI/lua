    local function beginResize(info, input)
        if not state.Resizable then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local start = input.Position
        local sw, sh = shell.AbsoluteSize.X, shell.AbsoluteSize.Y
        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920,1080)
        _drag = {Update = function(pos)
            local d = pos - start
            local nw = math.clamp(sw + info.X * d.X, MIN_W, math.min(MAX_W, vp.X))
            local nh = math.clamp(sh + info.Y * d.Y, MIN_H, math.min(MAX_H, vp.Y))
            winW, winH = nw, nh
            shell.Size = UDim2.fromOffset(nw, nh)
        end}
    end
    for _, info in ipairs(resizeHandles) do
        info.Hit.InputBegan:Connect(function(input) beginResize(info, input) end)
    end
