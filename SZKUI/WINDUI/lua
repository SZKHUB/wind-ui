        Parent = NotifContainer,
        Creator.create("UICorner", { CornerRadius = UDim.new(0, 10) }),
        Creator.create("UIStroke", {
            Color = Theme.Get("Accent"),
            Thickness = 1,
            Transparency = 0.3,
        }),
    })
    NotifCount = NotifCount + 1

    if iconId then
        Creator.create("ImageLabel", {
            Size = UDim2.fromOffset(24, 24),
            Position = UDim2.fromOffset(12, 20),
            BackgroundTransparency = 1,
            Image = iconId,
            ImageColor3 = Theme.Get("Accent"),
            Parent = notif,
        })
    end

    local textX = iconId and 44 or 12

    Creator.create("TextLabel", {
        Text = title,
        TextColor3 = Theme.Get("Text"),
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        Position = UDim2.fromOffset(textX, 10),
        Size = UDim2.new(1, -textX - 12, 0, 20),
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Parent = notif,
    })

    Creator.create("TextLabel", {
        Text = content,
        TextColor3 = Theme.Get("TextDim"),
        Font = Enum.Font.Gotham,
        TextSize = 12,
        Position = UDim2.fromOffset(textX, 32),
        Size = UDim2.new(1, -textX - 12, 0, 20),
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Parent = notif,
