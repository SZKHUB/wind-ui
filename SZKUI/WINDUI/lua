                BackgroundTransparency = 0,
                Text = tostring(selected),
                Font = Enum.Font.Gotham,
                TextSize = 11,
                TextColor3 = theme.Text,
                AutoButtonColor = false,
                ZIndex = 6,
            }, f)
            crn(chosen, 7)
            local ca = mk("ImageLabel", {
                AnchorPoint = Vector2.new(1, 0.5),
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -18, 0.5, 0),
                Size = UDim2.fromOffset(10, 10),
                Image = assetId("chevron-down"),
                ImageColor3 = theme.Muted,
                ZIndex = 7,
            }, f)

            local list = mk("Frame", {
                Name = "Popup",
                BackgroundColor3 = theme.Surface,
                BackgroundTransparency = 0,
                ClipsDescendants = true,
                Visible = false,
                ZIndex = 500,
                Size = UDim2.fromOffset(0, 0),
            }, gui)
            crn(list, 10)
            strk(list, theme.Stroke, 0.85, 1)

            local scroll = mk("ScrollingFrame", {
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Size = UDim2.fromScale(1, 1),
                CanvasSize = UDim2.new(),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                ScrollBarThickness = 2,
                ScrollBarImageColor3 = theme.Accent,
                ZIndex = 501,
            }, list)
            pad(scroll, 6, 6, 6, 6)
            mk("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder}, scroll)

            local function close()
                expanded = false
                tw(ca, 0.18, {Rotation = 0})
                local t = tw(list, 0.18, {Size = UDim2.fromOffset(list.Size.X.Offset, 0)}, Enum.EasingStyle.Quint)
                t.Completed:Connect(function() if not expanded then list.Visible = false end end)
            end
            local function rebuild()
                for _, ch in ipairs(scroll:GetChildren()) do
                    if ch:IsA("TextButton") then ch:Destroy() end
                end
                for i, opt in ipairs(options) do
                    local b = mk("TextButton", {
                        Size = UDim2.new(1, 0, 0, 30),
                        BackgroundColor3 = theme.Surface,
                        BackgroundTransparency = 1,
                        Text = "  " .. tostring(opt),
                        Font = Enum.Font.Gotham,
                        TextSize = 12,
                        TextColor3 = theme.Text,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        AutoButtonColor = false,
                        LayoutOrder = i,
                        ZIndex = 502,
                    }, scroll)
                    crn(b, 7)
                    b.MouseEnter:Connect(function() tw(b, 0.1, {BackgroundColor3 = theme.Elevated, BackgroundTransparency = 0}) end)
                    b.MouseLeave:Connect(function() tw(b, 0.1, {BackgroundTransparency = 1}) end)
                    b.MouseButton1Click:Connect(function()
                        selected = opt
                        chosen.Text = tostring(opt)
                        close()
                        if c.Callback then task.spawn(c.Callback, opt) end
                    end)
                end
            end
            rebuild()

            local function open()
                expanded = true
                tw(ca, 0.22, {Rotation = 180}, Enum.EasingStyle.Quint)
                local abs = chosen.AbsolutePosition
                local sz = chosen.AbsoluteSize
                local h = math.min(#options, 6) * 32 + 12
                local w = math.max(sz.X, 170)
                local rAbs = root.AbsolutePosition
                local rSz = root.AbsoluteSize
                local px = abs.X
                local py = abs.Y + sz.Y + 6
                if py + h > rAbs.Y + rSz.Y - 8 then py = abs.Y - h - 6 end
                px = math.clamp(px, rAbs.X + 4, rAbs.X + rSz.X - w - 4)
                py = math.clamp(py, rAbs.Y + 64, rAbs.Y + rSz.Y - h - 4)
                list.Position = UDim2.fromOffset(px, py)
                list.Size = UDim2.fromOffset(w, 0)
                list.Visible = true
                tw(list, 0.22, {Size = UDim2.fromOffset(w, h)}, Enum.EasingStyle.Quint)
            end

            chosen.MouseButton1Click:Connect(function() if expanded then close() else open() end end)
            local conn = UIS.InputBegan:Connect(function(input)
                if not expanded then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local p = input.Position
                    local function inside(o)
                        local a, s = o.AbsolutePosition, o.AbsoluteSize
                        return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
                    end
                    if not inside(list) and not inside(chosen) then close() end
                end
            end)
