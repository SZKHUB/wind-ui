        Parent = parentTab.ContentFrame,
        Creator.create("UICorner", { CornerRadius = UDim.new(0, 8) }),
        Creator.create("UIStroke", {
            Color = Theme.Get("Outline"),
            Thickness = 1,
            Transparency = 0.5,
        }),
    })

    if iconId then
        Creator.create("ImageLabel", {
            Size = UDim2.fromOffset(18, 18),
            Position = UDim2.fromOffset(12, 11),
            BackgroundTransparency = 1,
            Image = iconId,
            ImageColor3 = Theme.Get("Icon"),
            Parent = btn,
        })
    end

    Creator.create("TextLabel", {
        Text = config.Title or "Button",
        TextColor3 = Theme.Get("Text"),
        Font = Enum.Font.GothamMedium,
        TextSize = 14,
        Position = UDim2.fromOffset(iconId and 40 or 12, 0),
        Size = UDim2.new(0.7, 0, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Parent = btn,
    })

    if config.Desc then
        Creator.create("TextLabel", {
            Text = config.Desc,
            TextColor3 = Theme.Get("TextDim"),
            Font = Enum.Font.Gotham,
            TextSize = 11,
            Position = UDim2.new(0.7, 0, 0, 0),
            Size = UDim2.new(0.3, -12, 1, 0),
            TextXAlignment = Enum.TextXAlignment.Right,
            BackgroundTransparency = 1,
            Parent = btn,
        })
    end

    btn.MouseButton1Click:Connect(function()
        if config.Callback then
            local ok, err = pcall(config.Callback)
            if not ok then
                FluxesUI:Notify({ Title = "Error", Content = tostring(err), Duration = 5 })
            end
        end
    end)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = Theme.Get("Accent")
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = Theme.Get("Button")
        }):Play()
    end)

    return btn
end

function Window:Toggle(parentTab, config)
    config = config or {}
    local state = config.Default or config.Value or false
    local iconId = FluxesUI:GetIcon(config.Icon)

    local frame = Creator.create("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Theme.Get("Surface"),
        Parent = parentTab.ContentFrame,
        Creator.create("UICorner", { CornerRadius = UDim.new(0, 8) }),
    })

    if iconId then
        Creator.create("ImageLabel", {
            Size = UDim2.fromOffset(18, 18),
            Position = UDim2.fromOffset(12, 11),
            BackgroundTransparency = 1,
            Image = iconId,
            ImageColor3 = Theme.Get("Icon"),
            Parent = frame,
        })
    end

    Creator.create("TextLabel", {
        Text = config.Title or "Toggle",
        TextColor3 = Theme.Get("Text"),
        Font = Enum.Font.Gotham,
        TextSize = 14,
        Position = UDim2.fromOffset(iconId and 40 or 12, 0),
        Size = UDim2.new(0.6, 0, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Parent = frame,
    })

    local track = Creator.create("Frame", {
        Size = UDim2.fromOffset(42, 22),
        Position = UDim2.new(1, -54, 0.5, -11),
        BackgroundColor3 = state and Theme.Get("Accent") or Theme.Get("Outline"),
        Parent = frame,
        Creator.create("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local knob = Creator.create("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = Color3.new(1, 1, 1),
        Parent = track,
        Creator.create("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local click = Creator.create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        Parent = frame,
    })

    click.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(track, TweenInfo.new(0.2), {
            BackgroundColor3 = state and Theme.Get("Accent") or Theme.Get("Outline")
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Back), {
            Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        }):Play()
        if config.Callback then
            local ok, err = pcall(config.Callback, state)
            if not ok then
                FluxesUI:Notify({ Title = "Error", Content = tostring(err), Duration = 5 })
            end
        end
    end)

    return {
        Set = function(value)
            state = value
            track.BackgroundColor3 = state and Theme.Get("Accent") or Theme.Get("Outline")
            knob.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        end,
        Get = function() return state end,
    }
end

function Window:Slider(parentTab, config)
    config = config or {}
    local valueData = config.Value or { Min = 0, Max = 100, Default = 50 }
    local min = valueData.Min or 0
    local max = valueData.Max or 100
    local currentValue = valueData.Default or min
    local step = config.Step or 1

    local frame = Creator.create("Frame", {
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = Theme.Get("Surface"),
        Parent = parentTab.ContentFrame,
        Creator.create("UICorner", { CornerRadius = UDim.new(0, 8) }),
    })

    Creator.create("TextLabel", {
        Text = config.Title or "Slider",
        TextColor3 = Theme.Get("Text"),
        Font = Enum.Font.Gotham,
        TextSize = 14,
        Position = UDim2.fromOffset(12, 8),
        Size = UDim2.new(0.6, 0, 0, 20),
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Parent = frame,
    })

    local valueLabel = Creator.create("TextLabel", {
        Text = tostring(currentValue),
        TextColor3 = Theme.Get("Accent"),
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        Position = UDim2.new(0.6, 0, 0, 8),
        Size = UDim2.new(0.4, -12, 0, 20),
        TextXAlignment = Enum.TextXAlignment.Right,
        BackgroundTransparency = 1,
        Parent = frame,
    })

    local track = Creator.create("Frame", {
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.new(0, 12, 1, -20),
        BackgroundColor3 = Theme.Get("Outline"),
        Parent = frame,
        Creator.create("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local fill = Creator.create("Frame", {
        Size = UDim2.fromScale((currentValue - min) / (max - min), 1),
        BackgroundColor3 = Theme.Get("Accent"),
        Parent = track,
        Creator.create("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local knob = Creator.create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new((currentValue - min) / (max - min), 0, 0.5, -7),
        BackgroundColor3 = Color3.new(1, 1, 1),
        Parent = track,
        Creator.create("UICorner", { CornerRadius = UDim.new(1, 0) }),
        Creator.create("UIStroke", { Color = Theme.Get("Accent"), Thickness = 2 }),
    })

    local dragging = false
    local trackBtn = Creator.create("TextButton", {
        Size = UDim2.new(1, 20, 1, 30),
        Position = UDim2.new(0, -10, 0, -15),
        BackgroundTransparency = 1,
        Text = "",
        Parent = track,
    })

    trackBtn.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local percent = math.clamp(
                (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X,
                0, 1
            )
            local rawValue = min + (max - min) * percent
            local stepped = math.floor(rawValue / step + 0.5) * step
            stepped = math.clamp(stepped, min, max)

            if stepped ~= currentValue then
                currentValue = stepped
                fill.Size = UDim2.fromScale((currentValue - min) / (max - min), 1)
                knob.Position = UDim2.new((currentValue - min) / (max - min), 0, 0.5, -7)
                valueLabel.Text = tostring(currentValue)
                if config.Callback then
                    pcall(config.Callback, currentValue)
                end
            end
        end
    end)

    return {
        Set = function(v)
            currentValue = math.clamp(v, min, max)
            fill.Size = UDim2.fromScale((currentValue - min) / (max - min), 1)
            knob.Position = UDim2.new((currentValue - min) / (max - min), 0, 0.5, -7)
            valueLabel.Text = tostring(currentValue)
        end,
        Get = function() return currentValue end,
    }
end

