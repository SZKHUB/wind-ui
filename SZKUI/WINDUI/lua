        Font = Enum.Font.GothamBold,
        TextSize = 12,
        Position = UDim2.fromOffset(tabIcon and 36 or 12, 0),
        Size = UDim2.new(1, tabIcon and -40 or -16, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Parent = btn,
    })

    btn.MouseButton1Click:Connect(function() self:SelectTab(tabName) end)
    btn.MouseEnter:Connect(function()
        if self.ActiveTab ~= tabName then
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundColor3 = Theme.Get("SurfaceHover")
            }):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.ActiveTab ~= tabName then
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundColor3 = Theme.Get("Surface")
            }):Play()
        end
    end)

    -- Frame contenedor de la página
    local contentFrame = Creator.create("ScrollingFrame", {
        Name = tabName .. "_Content",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Get("Accent"),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
