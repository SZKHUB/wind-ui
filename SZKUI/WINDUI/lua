OpenHubUI._IconsLoaded = false

local function normIcon(v) return tostring(v):lower():gsub("%s+", "-"):gsub("_", "-") end
local function registerIcons(cat)
    if type(cat) ~= "table" then return end
    for n, id in pairs(cat) do
        if type(n) == "string" and (typeof(id) == "string" or typeof(id) == "number") then
            local a = typeof(id) == "number" and "rbxassetid://" .. tostring(id) or id
            OpenHubUI.Icons[n] = a; OpenHubUI.Icons[normIcon(n)] = a
        end
    end
end
function OpenHubUI:LoadIcons()
    if self._IconsLoaded then return self.Icons end
    self._IconsLoaded = true
    local c = loadstring or load
    if not c or not game or not game.HttpGet then return self.Icons end
    for _, src in ipairs(self.IconSources) do
        pcall(function()
            local code = game:HttpGet(src)
            local ch = c(code)
            if type(ch) == "function" then
                local ok, cat = pcall(ch); if ok then registerIcons(cat) end
            end
        end)
    end
    return self.Icons
end
function OpenHubUI:GetIcon(name)
    if typeof(name) ~= "string" then return nil end
    local d = self.Icons[name] or self.Icons[normIcon(name)]
    if d then return d end
    self:LoadIcons()
    return self.Icons[name] or self.Icons[normIcon(name)]
end

