    local function matches(obj, q)
        local n = string.lower(q or "")
        if n == "" then return true end
        if string.find(string.lower(obj.Name or ""), n, 1, true) then return true end
        for _, c in ipairs(obj:GetDescendants()) do
            if c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("TextBox") then
                local t = tostring(c.Text or c.PlaceholderText or "")
                if string.find(string.lower(t), n, 1, true) then return true end
            end
        end
        return false
    end

    local function filterSearch(q)
        q = tostring(q or "")
        local first, total = nil, 0
        for _, tab in ipairs(state.Tabs) do
            local gm = tab.Group and matches(tab.Group.Instance, q) or false
            local tm = gm or matches(tab.Page, q)
            for _, c in ipairs(tab.Page:GetChildren()) do
                if c:IsA("GuiObject") and not c:IsA("UIListLayout") then
                    c.Visible = q == "" or matches(c, q)
                end
            end
            tab.Button.Visible = q == "" or tm
            if tm then
                total = total + 1
                if not first then first = tab end
            end
        end
        for _, gr in ipairs(state.Groups) do
            local v = q == "" or matches(gr.Instance, q)
            for _, t in ipairs(gr.Tabs) do if t.Button.Visible then v = true end end
            gr.Instance.Visible = v
        end
        searchStatus.Visible = q ~= "" and total == 0
        if q ~= "" and first and first.Select then first.Select() end
    end

