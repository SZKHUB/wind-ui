    function state:SetTheme(n) local f = OpenHubUI.Themes[n]; if f then applyTheme(f, n) end end
    function state:CreateCustomTheme(n, v)
        n = tostring(n or "Custom")
        local c = deepCopy(theme)
        for k, val in pairs(v or {}) do if c[k] ~= nil then c[k] = val end end
        OpenHubUI.Themes[n] = c; applyTheme(c, n); return c
    end
    function state:GetThemes() return deepCopy(OpenHubUI.Themes) end
    function state:DeleteCustomTheme(n)
        if OpenHubUI.Themes[n] and not OpenHubUI.DefaultThemes[n] then
