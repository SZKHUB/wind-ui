            local item = {Instance = frame}
            function item:Set(value)
                if typeof(value) == "Color3" then updateFromColor(value, false) end
            end
            function item:Get() return color end
            function item:GetAlpha() return alpha end
            function item:UpdateTheme(t)
                frame.BackgroundColor3 = t.Surface
                lbl.TextColor3 = t.Text
                popup.BackgroundColor3 = t.Panel
                headerTitle.TextColor3 = t.Text
                closeButton.ImageColor3 = t.Muted
                hexBox.BackgroundColor3 = t.Surface
                hexBox.TextColor3 = t.Text
            end
            return addElement(item)
        end

        function tab:CreateDivider()
            local frame = make("Frame", {
                Name = "Divider",
                BackgroundColor3 = theme.Stroke,
                BackgroundTransparency = 0.9,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 1),
                ZIndex = 5,
            }, page)
            local item = {Instance = frame}
            function item:UpdateTheme(t) frame.BackgroundColor3 = t.Stroke end
            return addElement(item)
        end

        function tab:CreateProgressBar(cfg)
            cfg = cfg or {}
            local value = math.clamp(tonumber(cfg.Value) or 0, 0, 100)
            local frame = elementFrame(cfg.Name or "Progress", 52)
            local lbl = make("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(14, 7),
                Size = UDim2.new(1, -80, 0, 16),
                Text = cfg.Name or "Progress",
                Font = Enum.Font.GothamMedium,
                TextSize = 12,
                TextColor3 = theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 6,
            }, frame)
            local amt = make("TextLabel", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -14, 0, 7),
                Size = UDim2.fromOffset(52, 16),
                Text = tostring(value) .. "%",
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                TextColor3 = theme.Accent,
                TextXAlignment = Enum.TextXAlignment.Right,
                ZIndex = 6,
            }, frame)
            local track = make("Frame", {
                Position = UDim2.new(0, 14, 0, 32),
                Size = UDim2.new(1, -28, 0, 8),
                BackgroundColor3 = Color3.new(1,1,1),
                BackgroundTransparency = 0.88,
                BorderSizePixel = 0,
                ZIndex = 6,
            }, frame)
            corner(track, 4)
            local fill = make("Frame", {
                Size = UDim2.new(value / 100, 0, 1, 0),
                BackgroundColor3 = theme.Accent,
                BorderSizePixel = 0,
                ZIndex = 7,
            }, track)
            corner(fill, 4)
            make("UIGradient", {
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, theme.Accent),
                    ColorSequenceKeypoint.new(1, theme.Accent2),
                }),
            }, fill)
            local item = {Instance = frame}
            function item:Set(v)
                value = math.clamp(tonumber(v) or value, 0, 100)
                tween(fill, 0.3, {Size = UDim2.new(value/100, 0, 1, 0)}, Enum.EasingStyle.Quint)
                amt.Text = tostring(math.floor(value)) .. "%"
            end
            function item:Get() return value end
            function item:UpdateTheme(t)
                frame.BackgroundColor3 = t.Surface
                lbl.TextColor3 = t.Text
                amt.TextColor3 = t.Accent
                fill.BackgroundColor3 = t.Accent
            end
            return addElement(item)
        end

        function tab:CreateImage(cfg)
            cfg = type(cfg) == "table" and cfg or {Image = cfg}
            local imgSrc = cfg.Image or ""
            local resolved = loadLocalImage(imgSrc, cfg.Data)
            local frame = elementFrame(cfg.Name or "Image", cfg.Height or 140)
            local image = make("ImageLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(8, 8),
                Size = UDim2.new(1, -16, 1, -16),
                Image = resolved,
                ScaleType = cfg.ScaleType == "Fit" and Enum.ScaleType.Fit or Enum.ScaleType.Crop,
                ZIndex = 6,
            }, frame)
            corner(image, 9)
            local item = {Instance = frame}
            function item:Set(v) image.Image = loadLocalImage(v) end
            function item:UpdateTheme(t) frame.BackgroundColor3 = t.Surface end
            return addElement(item)
        end

        function tab:CreateSearchBox(cfg)
            cfg = cfg or {}
            local frame = elementFrame(cfg.Name or "Search", 54)
            local box = make("TextBox", {
                Position = UDim2.fromOffset(12, 12),
                Size = UDim2.new(1, -24, 0, 30),
                BackgroundColor3 = Color3.new(0,0,0),
                BackgroundTransparency = 0.55,
                Text = "",
                PlaceholderText = cfg.Placeholder or "Search...",
                ClearTextOnFocus = false,
                TextColor3 = theme.Text,
                PlaceholderColor3 = theme.Muted,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                BorderSizePixel = 0,
                ZIndex = 6,
            }, frame)
            corner(box, 8)
            pad(box, 12, 12, 0, 0)
            box:GetPropertyChangedSignal("Text"):Connect(function()
                if cfg.Callback then task.spawn(cfg.Callback, box.Text) end
            end)
            local item = {Instance = frame}
            function item:Set(v) box.Text = tostring(v) end
            function item:Get() return box.Text end
            function item:UpdateTheme(t)
                frame.BackgroundColor3 = t.Surface
                box.TextColor3 = t.Text
                box.PlaceholderColor3 = t.Muted
            end
            return addElement(item)
        end

        function tab:CreateMultiDropdown(cfg)
            cfg = cfg or {}
            local options = cfg.Options or {}
            local selected = {}
            for _, v in ipairs(cfg.CurrentOptions or {}) do selected[tostring(v)] = true end
            local frame = elementFrame(cfg.Name or "Multi", 48)
            local lbl = make("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(14, 0),
                Size = UDim2.new(0.42, 0, 1, 0),
                Text = cfg.Name or "Multi",
                Font = Enum.Font.GothamMedium,
                TextSize = 12,
                TextColor3 = theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 6,
            }, frame)
            local chosen = make("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -12, 0.5, 0),
                Size = UDim2.new(0.55, 0, 0, 30),
                BackgroundColor3 = Color3.new(0,0,0),
                BackgroundTransparency = 0.55,
                Text = "Select",
                Font = Enum.Font.Gotham,
                TextSize = 10,
                TextColor3 = theme.Text,
                AutoButtonColor = false,
                ZIndex = 6,
            }, frame)
            corner(chosen, 8)
            local chosenArrow = make("ImageLabel", {
                AnchorPoint = Vector2.new(1, 0.5),
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -18, 0.5, 0),
                Size = UDim2.fromOffset(12, 12),
                Image = assetId("chevron-down"),
                ImageColor3 = theme.Muted,
                ZIndex = 7,
            }, frame)

            local popup = make("Frame", {
                BackgroundColor3 = theme.Panel,
                BackgroundTransparency = 0.02,
                ClipsDescendants = true,
                Visible = false,
                ZIndex = 500,
                Size = UDim2.fromOffset(0, 0),
            }, gui)
            corner(popup, 12)
            stroke(popup, theme.Accent, 0.7, 1)

            local scroll = make("ScrollingFrame", {
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Size = UDim2.fromScale(1, 1),
                CanvasSize = UDim2.new(),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                ScrollBarThickness = 2,
                ZIndex = 501,
            }, popup)
            pad(scroll, 6, 6, 6, 6)
            make("UIListLayout", {Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder}, scroll)

            local function values()
                local out = {}
                for _, v in ipairs(options) do
                    if selected[tostring(v)] then table.insert(out, v) end
                end
                return out
            end

            local expanded = false
            local function closePopup()
                expanded = false
                tween(chosenArrow, 0.2, {Rotation = 0})
                local t = tween(popup, 0.2, {Size = UDim2.fromOffset(popup.Size.X.Offset, 0)}, Enum.EasingStyle.Quint)
                t.Completed:Connect(function() if not expanded then popup.Visible = false end end)
            end

            local function refresh()
                local vals = values()
                chosen.Text = #vals == 0 and "Select" or table.concat(vals, ", ")
                for _, b in ipairs(scroll:GetChildren()) do
                    if b:IsA("TextButton") then b:Destroy() end
                end
                for i, opt in ipairs(options) do
                    local isOn = selected[tostring(opt)]
                    local b = make("TextButton", {
                        Size = UDim2.new(1, 0, 0, 30),
                        BackgroundColor3 = isOn and theme.Accent or theme.Surface,
                        BackgroundTransparency = isOn and 0.25 or 0.4,
                        Text = tostring(opt),
                        Font = Enum.Font.Gotham,
                        TextSize = 11,
                        TextColor3 = theme.Text,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        AutoButtonColor = false,
                        LayoutOrder = i,
                        ZIndex = 502,
                    }, scroll)
                    corner(b, 7)
                    pad(b, 32, 8, 0, 0)
                    make("ImageLabel", {
                        BackgroundTransparency = 1,
                        Position = UDim2.fromOffset(10, 8),
                        Size = UDim2.fromOffset(14, 14),
                        Image = assetId(isOn and "check" or "circle"),
                        ImageColor3 = isOn and theme.Accent or theme.Muted,
                        ZIndex = 503,
                    }, b)
                    b.MouseButton1Click:Connect(function()
                        selected[tostring(opt)] = not selected[tostring(opt)]
                        refresh()
                        if cfg.Callback then task.spawn(cfg.Callback, values()) end
                    end)
                end
            end

            chosen.MouseButton1Click:Connect(function()
                if expanded then closePopup() else
                    expanded = true
                    tween(chosenArrow, 0.24, {Rotation = 180})
                    local abs = chosen.AbsolutePosition
                    local absSize = chosen.AbsoluteSize
                    local popupH = math.min(#options, 6) * 33 + 14
                    local popupW = math.max(absSize.X, 170)
                    local rAbs = root.AbsolutePosition
                    local rSz = root.AbsoluteSize
                    local px = abs.X
                    local py = abs.Y + absSize.Y + 6
                    if py + popupH > rAbs.Y + rSz.Y - 8 then py = abs.Y - popupH - 6 end
                    px = math.clamp(px, rAbs.X + 4, rAbs.X + rSz.X - popupW - 4)
                    py = math.clamp(py, rAbs.Y + 60, rAbs.Y + rSz.Y - popupH - 4)
                    popup.Position = UDim2.fromOffset(px, py)
                    popup.Size = UDim2.fromOffset(popupW, 0)
                    popup.Visible = true
                    tween(popup, 0.24, {Size = UDim2.fromOffset(popupW, popupH)}, Enum.EasingStyle.Back)
                end
            end)

            refresh()
            local item = {Instance = frame}
            function item:Set(v)
                selected = {}
                for _, x in ipairs(v or {}) do selected[tostring(x)] = true end
                refresh()
            end
            function item:Get() return values() end
            function item:UpdateOptions(v) options = v or {}; refresh() end
            function item:UpdateTheme(t)
                frame.BackgroundColor3 = t.Surface
                lbl.TextColor3 = t.Text
                chosen.TextColor3 = t.Text
                chosenArrow.ImageColor3 = t.Muted
                popup.BackgroundColor3 = t.Panel
                refresh()
            end
            return addElement(item)
        end

        function tab:CreateTextBox(cfg) return self:CreateInput(cfg) end

        table.insert(state.Tabs, tab)
        if #state.Tabs == 1 then selectTab() end
        return tab
    end

    -- ============ PUBLIC API ============
    function Window:SetTheme(name) state:SetTheme(name) end
    function Window:CreateCustomTheme(name, values) return state:CreateCustomTheme(name, values) end
    function Window:GetThemes() return state:GetThemes() end
    function Window:DeleteCustomTheme(name) return state:DeleteCustomTheme(name) end
    function Window:SetBackground(source, options) return state:SetBackground(source, options) end
    function Window:SetTransparency(v) state:SetTransparency(v) end
    function Window:SetAcrylic(v) state:SetAcrylic(v) end
    function Window:SetGlass(v) state:SetGlass(v) end
    function Window:SetResizable(v) state:SetResizable(v) end
    function Window:Notify(notice) return state:Notify(notice) end
    function Window:Destroy() state:Destroy() end
    function Window:Toggle() setOpen(not state.Open) end

    state.Window = Window

    if config.BackgroundImage then
        state:SetBackground(config.BackgroundImage, {
            Local = config.BackgroundLocal,
            Transparency = config.BackgroundImageTransparency or 0.7,
        })
    end

    -- Intro animation
    if config.Intro ~= false then
        shell.Size = UDim2.fromOffset(winW * 0.9, winH * 0.9)
        shell.BackgroundTransparency = 1
        openBtnHolder.Position = UDim2.new(0.5, 0, 0, -80)
        tween(shell, 0.42, {Size = UDim2.fromOffset(winW, winH), BackgroundTransparency = transparency}, Enum.EasingStyle.Back)
        task.delay(0.1, function()
            tween(openBtnHolder, 0.5, {Position = UDim2.new(0.5, 0, 0, 18)}, Enum.EasingStyle.Back)
        end)
    end

    return Window
end

return OpenHubUI
