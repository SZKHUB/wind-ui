--[[
    OpenHubUI - Lite / Skeleton
    Misma API que el original, pero con UI mínima.
    Muestra cómo funciona: CreateWindow -> CreateTab -> Create<Elemento>.
    NO incluye: glass, acrylic, gradients, resize, search, temas, iconos remotos.
    SÍ incluye: window, groups, tabs, section, label, button, toggle,
                slider, input, dropdown, keybind, divider, progressbar, notify.
--]]

local OpenHubUI = {}
OpenHubUI.Version = "3.0.0-lite"
OpenHubUI.Theme = {
    Bg      = Color3.fromRGB(20, 20, 28),
    Panel   = Color3.fromRGB(28, 28, 38),
    Surface = Color3.fromRGB(38, 38, 50),
    Accent  = Color3.fromRGB(130, 105, 255),
    Text    = Color3.fromRGB(240, 240, 245),
    Muted   = Color3.fromRGB(150, 155, 175),
}

local CoreGui = game:GetService("CoreGui")
local UIS     = game:GetService("UserInputService")

-- =================== HELPERS ===================
local function mk(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do pcall(function() o[k] = v end) end
    if parent then o.Parent = parent end
    return o
end
local function corner(p, r) return mk("UICorner", {CornerRadius = UDim.new(0, r or 6)}, p) end
local function pad(p, a, b, c, d) return mk("UIPadding", {
    PaddingLeft = UDim.new(0, a or 8),
    PaddingRight = UDim.new(0, b or a or 8),
    PaddingTop = UDim.new(0, c or 8),
    PaddingBottom = UDim.new(0, d or c or 8),
}, p) end

-- =================== WINDOW ===================
function OpenHubUI:CreateWindow(cfg)
    cfg = cfg or {}
    local T = self.Theme
    local parent = CoreGui
    pcall(function() if gethui then parent = gethui() end end)

    local gui = mk("ScreenGui", {
        Name = "OpenHubLite", IgnoreGuiInset = true,
        ResetOnSpawn = false, DisplayOrder = 999,
    }, parent)

    local root = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(cfg.Width or 600, cfg.Height or 460),
        BackgroundColor3 = T.Bg, BorderSizePixel = 0,
    }, gui)
    corner(root, 12)

    local header = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = T.Panel, BorderSizePixel = 0,
    }, root)
    corner(header, 12)

    mk("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 0),
        Size = UDim2.new(1, -70, 1, 0),
        Text = cfg.Title or "OpenHub Lite",
        Font = Enum.Font.GothamBold, TextSize = 15,
        TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
    }, header)

    local closeBtn = mk("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(28, 28),
        BackgroundColor3 = Color3.fromRGB(255, 80, 90),
        Text = "×", Font = Enum.Font.GothamBold, TextSize = 16,
        TextColor3 = Color3.new(1,1,1), BorderSizePixel = 0, AutoButtonColor = false,
    }, header)
    corner(closeBtn, 6)
    closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

    local tabList = mk("ScrollingFrame", {
        Position = UDim2.fromOffset(8, 48),
        Size = UDim2.new(0, 140, 1, -56),
        BackgroundColor3 = T.Panel, BorderSizePixel = 0,
        ScrollBarThickness = 2, ScrollBarImageColor3 = T.Accent,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, root)
    corner(tabList, 8)
    pad(tabList, 6, 6, 6, 6)
    mk("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder}, tabList)

    local content = mk("Frame", {
        Position = UDim2.new(0, 156, 0, 48),
        Size = UDim2.new(1, -164, 1, -56),
        BackgroundColor3 = T.Panel, BorderSizePixel = 0,
        ClipsDescendants = true,
    }, root)
    corner(content, 8)

    -- drag
    local dragging, dragStart, startPos
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, input.Position, root.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local state = { Tabs = {}, Selected = nil, Groups = {}, Theme = T }
    local W = { Instance = root, GUI = gui, State = state }
    local order = 0
    local currentGroup

    -- ============ CREATE TAB GROUP ============
    function W:CreateTabGroup(g)
        g = type(g) == "table" and g or { Name = tostring(g or "Group") }
        order = order + 1
        local frame = mk("Frame", {
            Size = UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = 1, LayoutOrder = order,
        }, tabList)
        mk("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
            Text = string.upper(g.Name or "GROUP"),
            Font = Enum.Font.GothamBold, TextSize = 10,
            TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left,
        }, frame)
        local group = { Instance = frame, Tabs = {} }
        currentGroup = group
        table.insert(state.Groups, group)
        return group
    end

    -- ============ CREATE TAB ============
    function W:CreateTab(c)
        c = c or {}
        local name = c.Name or ("Tab " .. (#state.Tabs + 1))
        order = order + 1

        local btn = mk("TextButton", {
            Size = UDim2.new(1, 0, 0, 30),
            BackgroundColor3 = T.Accent, BackgroundTransparency = 1,
            Text = name, Font = Enum.Font.Gotham, TextSize = 12,
            TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false, LayoutOrder = order,
        }, tabList)
        corner(btn, 6); pad(btn, 10, 10, 0, 0)

        local page = mk("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            BorderSizePixel = 0, CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 2, ScrollBarImageColor3 = T.Accent,
            Visible = false,
        }, content)
        pad(page, 10, 10, 10, 10)
        mk("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, page)

        local tab = { Name = name, Button = btn, Page = page, Elements = {}, Group = currentGroup }

        local function select()
            for _, o in ipairs(state.Tabs) do
                o.Page.Visible = false
                o.Button.TextColor3 = T.Muted
                o.Button.BackgroundTransparency = 1
            end
            page.Visible = true
            btn.TextColor3 = T.Text
            btn.BackgroundTransparency = 0.55
            btn.BackgroundColor3 = T.Accent
            state.Selected = name
            page.CanvasPosition = Vector2.new(0, 0)
        end
        tab.Select = select
        btn.MouseButton1Click:Connect(select)
        if currentGroup then table.insert(currentGroup.Tabs, tab) end

        local function frame(h)
            local f = mk("Frame", {
                Size = UDim2.new(1, 0, 0, h or 40),
                BackgroundColor3 = T.Surface, BorderSizePixel = 0,
            }, page)
            corner(f, 6); return f
        end
        local function add(item) table.insert(tab.Elements, item); return item end

        -- Section
        function tab:CreateSection(text)
            local lbl = mk("TextLabel", {
                Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1,
                Text = text or "Section", Font = Enum.Font.GothamBold,
                TextSize = 12, TextColor3 = T.Accent,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, page)
            return add({ Instance = lbl })
        end

        -- Label
        function tab:CreateLabel(c)
            c = type(c) == "table" and c or { Text = tostring(c or "Label") }
            local f = frame(c.Height or 32)
            local lbl = mk("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0),
                Size = UDim2.new(1, -24, 1, 0), Text = c.Text or "Label",
                Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.Text,
                TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
            }, f)
            local item = { Instance = f }
            function item:Set(t) lbl.Text = tostring(t) end
            return add(item)
        end

        -- Button
        function tab:CreateButton(c)
            c = type(c) == "table" and c or { Name = tostring(c or "Button") }
            local f = frame(38)
            local b = mk("TextButton", {
                BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
                Text = "", AutoButtonColor = false,
            }, f)
            mk("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0),
                Size = UDim2.new(1, -24, 1, 0), Text = c.Name or "Button",
                Font = Enum.Font.GothamMedium, TextSize = 12,
                TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
            }, b)
            b.MouseButton1Click:Connect(function()
                if c.Callback then task.spawn(c.Callback) end
            end)
            return add({ Instance = f })
        end

        -- Toggle
        function tab:CreateToggle(c)
            c = c or {}
            local value = c.CurrentValue == true
            local f = frame(38)
            mk("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0),
                Size = UDim2.new(1, -70, 1, 0), Text = c.Name or "Toggle",
                Font = Enum.Font.GothamMedium, TextSize = 12,
                TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
            }, f)
            local sw = mk("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
                Size = UDim2.fromOffset(38, 20),
                BackgroundColor3 = value and T.Accent or Color3.fromRGB(60,60,70),
                Text = "", AutoButtonColor = false,
            }, f)
            corner(sw, 10)
            local knob = mk("Frame", {
                Position = value and UDim2.new(1, -18, 0, 2) or UDim2.fromOffset(2, 2),
                Size = UDim2.fromOffset(16, 16),
                BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0,
            }, sw)
            corner(knob, 8)
            local function set(v, fire)
                value = v == true
                sw.BackgroundColor3 = value and T.Accent or Color3.fromRGB(60,60,70)
                knob.Position = value and UDim2.new(1, -18, 0, 2) or UDim2.fromOffset(2, 2)
                if fire and c.Callback then task.spawn(c.Callback, value) end
            end
            sw.MouseButton1Click:Connect(function() set(not value, true) end)
            local item = { Instance = f }
            function item:Set(v) set(v, true) end
            function item:Get() return value end
            if c.CurrentValue and c.Callback then task.spawn(c.Callback, value) end
            return add(item)
        end

        -- Slider
        function tab:CreateSlider(c)
            c = c or {}
            local min = tonumber(c.Min) or 0
            local max = tonumber(c.Max) or 100
            local value = math.clamp(tonumber(c.CurrentValue) or min, min, max)
            local f = frame(50)
            mk("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 4),
                Size = UDim2.new(1, -70, 0, 14), Text = c.Name or "Slider",
                Font = Enum.Font.GothamMedium, TextSize = 12,
                TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
            }, f)
            local valLbl = mk("TextLabel", {
                BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -10, 0, 4), Size = UDim2.fromOffset(50, 14),
                Text = tostring(value), Font = Enum.Font.GothamBold,
                TextSize = 11, TextColor3 = T.Accent,
                TextXAlignment = Enum.TextXAlignment.Right,
            }, f)
            local track = mk("Frame", {
                Position = UDim2.new(0, 12, 0, 30), Size = UDim2.new(1, -24, 0, 5),
                BackgroundColor3 = Color3.new(1,1,1), BackgroundTransparency = 0.85,
                BorderSizePixel = 0,
            }, f)
            corner(track, 3)
            local fill = mk("Frame", {
                Size = UDim2.new((value-min)/math.max(max-min,1), 0, 1, 0),
                BackgroundColor3 = T.Accent, BorderSizePixel = 0,
            }, track)
            corner(fill, 3)
            local hit = mk("TextButton", {
                BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, -8),
                Size = UDim2.new(1, 0, 1, 16), Text = "",
            }, track)
            local function set(v, fire)
                value = math.clamp(v, min, max)
                local p = (value - min) / math.max(max - min, 1)
                fill.Size = UDim2.new(p, 0, 1, 0)
                valLbl.Text = tostring(math.floor(value*100)/100)
                if fire and c.Callback then task.spawn(c.Callback, value) end
            end
            local sliding = false
            hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    local p = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
                    set(min + (max-min)*p, true)
                end
            end)
            UIS.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local p = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
                    set(min + (max-min)*p, true)
                end
            end)
            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = false end
            end)
            local item = { Instance = f }
            function item:Set(v) set(tonumber(v) or value, true) end
            function item:Get() return value end
            return add(item)
        end

        -- Input / TextBox
        function tab:CreateInput(c)
            c = c or {}
            local f = frame(48)
            mk("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 3),
                Size = UDim2.new(1, -24, 0, 12), Text = c.Name or "Input",
                Font = Enum.Font.GothamMedium, TextSize = 11,
                TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left,
            }, f)
            local box = mk("TextBox", {
                Position = UDim2.fromOffset(12, 18), Size = UDim2.new(1, -24, 0, 22),
                BackgroundColor3 = Color3.new(0,0,0), BackgroundTransparency = 0.5,
                Text = tostring(c.Default or ""),
                PlaceholderText = c.Placeholder or "Enter...",
                ClearTextOnFocus = false, TextColor3 = T.Text,
                PlaceholderColor3 = T.Muted, Font = Enum.Font.Gotham,
                TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
                BorderSizePixel = 0,
            }, f)
            corner(box, 5); pad(box, 6, 6, 0, 0)
            box.FocusLost:Connect(function(enter)
                if (not c.Enter or enter) and c.Callback then task.spawn(c.Callback, box.Text) end
            end)
            local item = { Instance = f }
            function item:Set(v) box.Text = tostring(v) end
            function item:Get() return box.Text end
            return add(item)
        end
        tab.CreateTextBox = tab.CreateInput

        -- Dropdown
        function tab:CreateDropdown(c)
            c = c or {}
            local options = c.Options or {"Option 1", "Option 2"}
            local selected = c.CurrentOption or options[1]
            if type(selected) == "table" then selected = selected[1] end
            local f = frame(38)
            mk("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0),
                Size = UDim2.new(0.4, 0, 1, 0), Text = c.Name or "Dropdown",
                Font = Enum.Font.GothamMedium, TextSize = 12,
                TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
            }, f)
            local chosen = mk("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
                Size = UDim2.new(0.55, 0, 0, 24),
                BackgroundColor3 = Color3.new(0,0,0), BackgroundTransparency = 0.5,
                Text = tostring(selected), Font = Enum.Font.Gotham, TextSize = 11,
                TextColor3 = T.Text, AutoButtonColor = false,
            }, f)
            corner(chosen, 6)

            local popup = mk("Frame", {
                BackgroundColor3 = T.Panel, Visible = false,
                Size = UDim2.fromOffset(0, 0), ZIndex = 500, ClipsDescendants = true,
            }, gui)
            corner(popup, 8)
            local scroll = mk("ScrollingFrame", {
                BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
                BorderSizePixel = 0, CanvasSize = UDim2.new(),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                ScrollBarThickness = 2, ScrollBarImageColor3 = T.Accent,
            }, popup)
            pad(scroll, 4, 4, 4, 4)
            mk("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder}, scroll)

            local expanded = false
            local function close() expanded = false; popup.Visible = false end
            local function rebuild()
                for _, o in ipairs(scroll:GetChildren()) do
                    if o:IsA("TextButton") then o:Destroy() end
                end
                for i, opt in ipairs(options) do
                    local b = mk("TextButton", {
                        Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = T.Surface,
                        Text = "  " .. tostring(opt), Font = Enum.Font.Gotham,
                        TextSize = 11, TextColor3 = T.Text,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        AutoButtonColor = false, LayoutOrder = i,
                    }, scroll)
                    corner(b, 5)
                    b.MouseButton1Click:Connect(function()
                        selected = opt; chosen.Text = tostring(opt); close()
                        if c.Callback then task.spawn(c.Callback, opt) end
                    end)
                end
            end
            rebuild()

            chosen.MouseButton1Click:Connect(function()
                if expanded then close() return end
                expanded = true
                local a, s = chosen.AbsolutePosition, chosen.AbsoluteSize
                popup.Position = UDim2.fromOffset(a.X, a.Y + s.Y + 4)
                popup.Size = UDim2.fromOffset(math.max(s.X, 160), math.min(#options, 6) * 28 + 8)
                popup.Visible = true
            end)
            UIS.InputBegan:Connect(function(input)
                if not expanded then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local p = input.Position
                    local a, s = popup.AbsolutePosition, popup.AbsoluteSize
                    if p.X < a.X or p.X > a.X + s.X or p.Y < a.Y or p.Y > a.Y + s.Y then
                        local ca, cs = chosen.AbsolutePosition, chosen.AbsoluteSize
                        if not (p.X >= ca.X and p.X <= ca.X + cs.X and p.Y >= ca.Y and p.Y <= ca.Y + cs.Y) then close() end
                    end
                end
            end)

            local item = { Instance = f }
            function item:Set(v) selected = v; chosen.Text = tostring(v)
                if c.Callback then task.spawn(c.Callback, v) end end
            function item:Get() return selected end
            function item:UpdateOptions(v) options = v or {}; rebuild() end
            return add(item)
        end

        -- Keybind
        function tab:CreateKeybind(c)
            c = c or {}
            local key = c.CurrentBind or "RightShift"
            local listening = false
            local f = frame(38)
            mk("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0),
                Size = UDim2.new(1, -100, 1, 0), Text = c.Name or "Keybind",
                Font = Enum.Font.GothamMedium, TextSize = 12,
                TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
            }, f)
            local b = mk("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
                Size = UDim2.fromOffset(80, 24), BackgroundColor3 = Color3.new(0,0,0),
                BackgroundTransparency = 0.5, Text = key,
                Font = Enum.Font.GothamBold, TextSize = 10,
                TextColor3 = T.Accent, AutoButtonColor = false,
            }, f)
            corner(b, 6)
            b.MouseButton1Click:Connect(function() listening = true; b.Text = "..." end)
            UIS.InputBegan:Connect(function(input, processed)
                if processed then return end
                if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                    key = input.KeyCode.Name; b.Text = key; listening = false
                elseif not listening and input.KeyCode.Name == key and c.Callback then
                    task.spawn(c.Callback, key)
                end
            end)
            local item = { Instance = f }
            function item:Set(v) key = tostring(v); b.Text = key end
            function item:Get() return key end
            return add(item)
        end

        -- Divider
        function tab:CreateDivider()
            local d = mk("Frame", {
                Size = UDim2.new(1, 0, 0, 1),
                BackgroundColor3 = T.Muted, BackgroundTransparency = 0.6,
                BorderSizePixel = 0,
            }, page)
            return add({ Instance = d })
        end

        -- ProgressBar
        function tab:CreateProgressBar(c)
            c = c or {}
            local value = math.clamp(tonumber(c.Value) or 0, 0, 100)
            local f = frame(44)
            mk("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 4),
                Size = UDim2.new(1, -70, 0, 14), Text = c.Name or "Progress",
                Font = Enum.Font.GothamMedium, TextSize = 12,
                TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
            }, f)
            local amt = mk("TextLabel", {
                BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -10, 0, 4), Size = UDim2.fromOffset(48, 14),
                Text = tostring(value) .. "%", Font = Enum.Font.GothamBold,
                TextSize = 11, TextColor3 = T.Accent,
                TextXAlignment = Enum.TextXAlignment.Right,
            }, f)
            local track = mk("Frame", {
                Position = UDim2.new(0, 12, 0, 26), Size = UDim2.new(1, -24, 0, 6),
                BackgroundColor3 = Color3.new(1,1,1), BackgroundTransparency = 0.85,
                BorderSizePixel = 0,
            }, f)
            corner(track, 3)
            local fill = mk("Frame", {
                Size = UDim2.new(value/100, 0, 1, 0),
                BackgroundColor3 = T.Accent, BorderSizePixel = 0,
            }, track)
            corner(fill, 3)
            local item = { Instance = f }
            function item:Set(v)
                value = math.clamp(tonumber(v) or value, 0, 100)
                fill.Size = UDim2.new(value/100, 0, 1, 0)
                amt.Text = tostring(math.floor(value)) .. "%"
            end
            function item:Get() return value end
            return add(item)
        end

        table.insert(state.Tabs, tab)
        if #state.Tabs == 1 then select() end
        return tab
    end

    -- ============ NOTIFY ============
    function W:Notify(n)
        n = type(n) == "table" and n or { Text = tostring(n) }
        local holder = gui:FindFirstChild("Notifs")
        if not holder then
            holder = mk("Frame", {
                Name = "Notifs", AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -16, 0, 16),
                Size = UDim2.fromOffset(260, 400), BackgroundTransparency = 1, ZIndex = 400,
            }, gui)
            mk("UIListLayout", {
                Padding = UDim.new(0, 8),
                HorizontalAlignment = Enum.HorizontalAlignment.Right,
                SortOrder = Enum.SortOrder.LayoutOrder,
            }, holder)
        end
        local card = mk("Frame", {
            BackgroundColor3 = T.Panel, Size = UDim2.fromOffset(260, 56), ZIndex = 401,
        }, holder)
        corner(card, 8)
        mk("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 6),
            Size = UDim2.new(1, -24, 0, 18), Text = n.Title or "Notice",
            Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = T.Text,
            TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 402,
        }, card)
        mk("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 26),
            Size = UDim2.new(1, -24, 0, 26), Text = n.Content or n.Text or "",
            Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = T.Muted,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true, ZIndex = 402,
        }, card)
        task.delay(tonumber(n.Duration) or 4, function()
            if card.Parent then card:Destroy() end
        end)
        return card
    end

    function W:Destroy() gui:Destroy() end
    state.Window = W
    return W
end

return OpenHubUI
