        local f = OpenHubUI.Themes[name]
        if f then applyTheme(f, name) end
    end
    function state:CreateCustomTheme(name, values)
        name = tostring(name or "Custom")
        local c = deepCopy(theme)
        for k, v in pairs(values or {}) do if c[k] ~= nil then c[k] = v end end
        OpenHubUI.Themes[name] = c
        applyTheme(c, name)
        return c
    end
    function state:GetThemes() return deepCopy(OpenHubUI.Themes) end
    function state:DeleteCustomTheme(name)
        if OpenHubUI.Themes[name] and not OpenHubUI.DefaultThemes[name] then
            OpenHubUI.Themes[name] = nil
            if state.ThemeName == name then applyTheme(OpenHubUI.Themes.Midnight, "Midnight") end
            return true
        end
        return false
    end
