            PaddingLeft = UDim.new(0, 9),
            PaddingRight = UDim.new(0, 9),
        }),
        Creator.create("UIListLayout", {
            Padding = UDim.new(0, 7),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }),
    })

    tab.Button = btn
    tab.ContentFrame = contentFrame
    tab.Icon = iconLabel
    tab.TextLabel = textLabel
    self.Tabs[tabName] = tab
    self.TabButtons[#self.TabButtons + 1] = btn
    self._TabOrder[#self._TabOrder + 1] = tabName

    if not self.ActiveTab then
        self:SelectTab(tabName)
    end

    return tab
end

-- Helper seguro para iconos dentro del método Tab
function SZKUI_GetIconSafe(name)
    return FluxesUI:GetIcon(name)
end

function Window:SelectTab(name)
    for tabName, tab in pairs(self.Tabs) do
        local active = tabName == name
        tab.ContentFrame.Visible = active
        if active then
            tab.Button.BackgroundColor3 = Theme.Get("Accent")
            tab.Button.BackgroundTransparency = 0
            if tab.TextLabel then tab.TextLabel.TextColor3 = Theme.Get("Background") end
            if tab.Icon then tab.Icon.ImageColor3 = Theme.Get("Background") end
        else
            tab.Button.BackgroundColor3 = Theme.Get("Surface")
            tab.Button.BackgroundTransparency = 0.5
            if tab.TextLabel then tab.TextLabel.TextColor3 = Theme.Get("TextDim") end
            if tab.Icon then tab.Icon.ImageColor3 = Theme.Get("TextDim") end
        end
    end
    self.ActiveTab = name
end

