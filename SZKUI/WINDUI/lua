local function fetchUrl(url)
    local ok, res = pcall(function()
        if typeof(game.HttpGet) == "function" then return game:HttpGet(url) end
    end)
    if ok and res then return res end
    local ok2, res2 = pcall(function() return HttpService:GetAsync(url) end)
    if ok2 and res2 then return res2 end
    return nil
end

local function compile(src)
    if loadstring then return loadstring(src) end
    if load then return load(src) end
    return nil
end

local IconPacks = {}
local LegacyIcons = {}
local DefaultIconType = "SZK2"

local function loadPack(name, url)
    local ok, data = pcall(function()
        local src = fetchUrl(url)
        if not src then return nil end
        local fn = compile(src)
        if not fn then return nil end
        return fn()
    end)
    if ok and type(data) == "table" then
        IconPacks[name] = data
    end
end

task.spawn(function()
    for name, url in pairs(SZK_URLS) do loadPack(name, url) end
end)
