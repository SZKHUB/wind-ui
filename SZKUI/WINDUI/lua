                    }, b)
                    b.MouseEnter:Connect(function() if not isOn then tw(b, 0.1, {BackgroundColor3 = theme.Elevated, BackgroundTransparency = 0}) end end)
                    b.MouseLeave:Connect(function() if not isOn then tw(b, 0.1, {BackgroundTransparency = 1}) end end)
                    b.MouseButton1Click:Connect(function()
                        selected[tostring(opt)] = not selected[tostring(opt)]
                        refresh()
                        if c.Callback then task.spawn(c.Callback, values()) end
                    end)
                end
            end

            chosen.MouseButton1Click:Connect(function()
                if expanded then close() else
                    expanded = true
                    tw(ca, 0.22, {Rotation = 180}, Enum.EasingStyle.Quint)
                    local abs = chosen.AbsolutePosition
                    local sz = chosen.AbsoluteSize
                    local h = math.min(#options, 6) * 32 + 12
                    local w = math.max(sz.X, 170)
                    local rA = root.AbsolutePosition
                    local rS = root.AbsoluteSize
                    local px = abs.X
                    local py = abs.Y + sz.Y + 6
                    if py + h > rA.Y + rS.Y - 8 then py = abs.Y - h - 6 end
                    px = math.clamp(px, rA.X + 4, rA.X + rS.X - w - 4)
                    py = math.clamp(py, rA.Y + 64, rA.Y + rS.Y - h - 4)
                    popup.Position = UDim2.fromOffset(px, py)
                    popup.Size = UDim2.fromOffset(w, 0)
                    popup.Visible = true
                    tw(popup, 0.22, {Size = UDim2.fromOffset(w, h)}, Enum.EasingStyle.Quint)
                end
            end)

            refresh()
            local item = {Instance = f}
            function item:Set(v)
                selected = {}
                for _, x in ipairs(v or {}) do selected[tostring(x)] = true end
                refresh()
            end
            function item:Get() return values() end
            function item:UpdateOptions(v) options = v or {}; refresh() end
            function item:UpdateTheme(t)
                f.BackgroundColor3 = t.Surface
                l.TextColor3 = t.Text
                chosen.BackgroundColor3 = t.Elevated
                chosen.TextColor3 = t.Text
                ca.ImageColor3 = t.Muted
                popup.BackgroundColor3 = t.Surface
                refresh()
            end
            return addEl(item)
        end

        function tab:CreateTextBox(c) return self:CreateInput(c) end

        table.insert(state.Tabs, tab)
        if #state.Tabs == 1 then selectTab() end
        return tab
    end

    -- ========== PUBLIC API ==========
    function Window:SetTheme(n) state:SetTheme(n) end
    function Window:CreateCustomTheme(n, v) return state:CreateCustomTheme(n, v) end
    function Window:GetThemes() return state:GetThemes() end
    function Window:DeleteCustomTheme(n) return state:DeleteCustomTheme(n) end
    function Window:SetBackground(s, o) return state:SetBackground(s, o) end
    function Window:SetTransparency(v) state:SetTransparency(v) end
    function Window:SetAcrylic(v) state:SetAcrylic(v) end
    function Window:SetGlass(v) state:SetGlass(v) end
    function Window:SetResizable(v) state:SetResizable(v) end
    function Window:Notify(n) return state:Notify(n) end
    function Window:Destroy() state:Destroy() end
    function Window:Toggle() setOpen(not state.Open) end

    state.Window = Window

    if cfg.BackgroundImage then
        state:SetBackground(cfg.BackgroundImage, {
            Local = cfg.BackgroundLocal,
            Transparency = cfg.BackgroundImageTransparency or 0.82,
        })
    end

    if cfg.Intro ~= false then
        shell.Size = UDim2.fromOffset(winW * 0.94, winH * 0.94)
        shell.BackgroundTransparency = 1
        openHolder.Position = UDim2.new(0.5, 0, 0, -70)
        tw(shell, 0.32, {Size = UDim2.fromOffset(winW, winH), BackgroundTransparency = transparency}, Enum.EasingStyle.Quint)
        task.delay(0.08, function()
            tw(openHolder, 0.4, {Position = UDim2.new(0.5, 0, 0, 18)}, Enum.EasingStyle.Quint)
        end)
    end

    return Window
end

return OpenHubUI
