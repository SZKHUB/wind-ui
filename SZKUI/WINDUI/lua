local function mk(c, p, par)
    local o = Instance.new(c)
    for k, v in pairs(p or {}) do pcall(function() o[k] = v end) end
    if par then o.Parent = par end
    return o
end
local function crn(p, r) return mk("UICorner", {CornerRadius = UDim.new(0, r or 8)}, p) end
local function strk(p, col, tr, th)
    return mk("UIStroke", {Color = col or Color3.new(1,1,1), Transparency = tr or 0.9, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, p)
end
local function pad(p, l, r, t, b)
    return mk("UIPadding", {
        PaddingLeft = UDim.new(0, l or 14), PaddingRight = UDim.new(0, r or l or 14),
        PaddingTop = UDim.new(0, t or 12), PaddingBottom = UDim.new(0, b or t or 12),
    }, p)
end
local function tw(obj, t, props, style, dir)
    local ti = TweenInfo.new(t or 0.22, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out)
    local tr = TS:Create(obj, ti, props)
    tr:Play()
    return tr
end
local function ripple(btn, col)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local rel = input.Position - btn.AbsolutePosition
        local r = mk("Frame", {
            AnchorPoint = Vector2.new(0.5,0.5),
            Position = UDim2.fromOffset(rel.X, rel.Y),
            Size = UDim2.fromOffset(0,0),
            BackgroundColor3 = col or Color3.new(1,1,1),
            BackgroundTransparency = 0.65,
            BorderSizePixel = 0,
            ZIndex = 90,
        }, btn)
        crn(r, 999)
        local t = tw(r, 0.55, {Size = UDim2.fromOffset(160,160), BackgroundTransparency = 1}, Enum.EasingStyle.Quart)
        t.Completed:Connect(function() if r.Parent then r:Destroy() end end)
    end)
end
local function assetId(v)
    if typeof(v) == "number" then return "rbxassetid://" .. v end
    if typeof(v) ~= "string" then return "" end
    if v == "" then return "" end
    if v:match("^rbxassetid://") or v:match("^https?://") then return v end
    if v:match("^%d+$") then return "rbxassetid://" .. v end
    local i = OpenHubUI:GetIcon(v)
    if i then return i end
    return v
end
local function resolveAsset(p)
    if typeof(p) ~= "string" then return nil end
    if p:match("^rbxassetid://") or p:match("^https?://") then return p end
    if getsynasset then local ok, r = pcall(getsynasset, p); if ok and r and r ~= "" then return r end end
    if getcustomasset then local ok, r = pcall(getcustomasset, p); if ok and r and r ~= "" then return r end end
    return nil
end
local function downloadAsset(p)
    if typeof(p) ~= "string" or not p:match("^https?://") then return nil end
    local data
    local rf = request or http_request or (syn and syn.request)
    if rf then local ok, r = pcall(rf, {Url = p, Method = "GET"}); if ok and type(r) == "table" and (r.Success == nil or r.Success) then data = r.Body end end
    if not data and game and game.HttpGet then local ok, r = pcall(function() return game:HttpGet(p) end); if ok then data = r end end
    if not data or not writefile then return nil end
    local ext = (p:match("%.([%a%d]+)") or "jpg"):lower()
    if ext ~= "png" and ext ~= "jpg" and ext ~= "jpeg" and ext ~= "gif" and ext ~= "webp" then ext = "jpg" end
    local fn = "OHUI_" .. HS:GenerateGUID(false):gsub("-","") .. "." .. ext
    local ok = pcall(writefile, fn, data)
    if not ok then return nil end
    return resolveAsset(fn)
end
local function loadLocalImage(p, data)
    if typeof(p) == "number" then return assetId(p) end
    if typeof(p) ~= "string" then return "" end
    if p:match("^https?://") then return downloadAsset(p) or p end
    if p:match("^rbxassetid://") then return p end
    if p:match("%.png$") or p:match("%.jpg$") or p:match("%.jpeg$") or p:match("%.gif$") then
        if data and writefile then pcall(writefile, p, data) end
        local r = resolveAsset(p); if r then return r end
    end
    return assetId(p)
end
local function deepCopy(s) local o = {}; for k,v in pairs(s) do o[k]=v end; return o end
local function normalizeColor(v, fb)
    if typeof(v) == "Color3" then return v end
    if type(v) == "table" then
        local r,g,b = tonumber(v.R or v[1]), tonumber(v.G or v[2]), tonumber(v.B or v[3])
        if r and g and b then
            if r <= 1 and g <= 1 and b <= 1 then return Color3.new(r,g,b) end
            return Color3.fromRGB(r,g,b)
        end
    end
    if type(v) == "string" then
        local h = v:gsub("#",""):gsub("%s","")
        if #h == 6 then
            local r,g,b = tonumber(h:sub(1,2),16), tonumber(h:sub(3,4),16), tonumber(h:sub(5,6),16)
            if r and g and b then return Color3.fromRGB(r,g,b) end
        end
    end
    return fb
end

