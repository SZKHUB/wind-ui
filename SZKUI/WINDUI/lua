        local function selectTab()
            state.SelectedTab = tabName
            for _, other in ipairs(state.Tabs) do
                other.Page.Visible = false
                tween(other.Button, 0.2, {BackgroundTransparency = 1}, Enum.EasingStyle.Quint)
                tween(other.Indicator, 0.24, {Size = UDim2.new(0, 3, 0, 0)}, Enum.EasingStyle.Quint)
                other.Label.TextColor3 = theme.Muted
                other.Icon.ImageColor3 = theme.Muted
            end
            page.Visible = true
            tween(button, 0.24, {BackgroundTransparency = 0.82}, Enum.EasingStyle.Quint)
            tween(indicator, 0.3, {Size = UDim2.new(0, 3, 0, 22)}, Enum.EasingStyle.Back)
            label.TextColor3 = theme.Text
            icon.ImageColor3 = theme.Accent
            page.CanvasPosition = Vector2.new(0, 0)
        end
        tab.Select = selectTab
        button.MouseButton1Click:Connect(selectTab)
        button.MouseEnter:Connect(function()
            if not page.Visible then tween(button, 0.14, {BackgroundTransparency = 0.92}) end
        end)
        button.MouseLeave:Connect(function()
            if not page.Visible then tween(button, 0.14, {BackgroundTransparency = 1}) end
        end)

        function tab:UpdateTheme(nt)
            button.BackgroundColor3 = nt.Accent
            indicator.BackgroundColor3 = nt.Accent
            page.ScrollBarImageColor3 = nt.Accent
            if page.Visible then
                label.TextColor3 = nt.Text
                icon.ImageColor3 = nt.Accent
            else
                label.TextColor3 = nt.Muted
                icon.ImageColor3 = nt.Muted
            end
            for _, el in ipairs(tab.Elements) do
                pcall(function() if el.UpdateTheme then el:UpdateTheme(nt) end end)
            end
        end

