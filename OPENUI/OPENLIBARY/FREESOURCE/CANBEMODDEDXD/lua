--  INTERACTION HELPERS
--==================================================================
local function Ripple(parent, pos, alpha)
    local ap, as = parent.AbsolutePosition, parent.AbsoluteSize
    local r = New("Frame", { AnchorPoint = Vector2.new(0.5,0.5),
        Position = UDim2.fromOffset(pos.X-ap.X, pos.Y-ap.Y), Size = UDim2.fromOffset(0,0),
        BackgroundColor3 = WHITE, BackgroundTransparency = alpha or 0.72, Parent = parent })
    Circle(r)
    local d = math.max(as.X, as.Y) * 2.4
    TW(r, 0.6, { Size = UDim2.fromOffset(d,d), BackgroundTransparency = 1 })
    Debris:AddItem(r, 0.7)
end
local function Interact(btn, o)
    o = o or {}; btn.AutoButtonColor = false
    local scale = (o.scale ~= false) and New("UIScale", { Parent = btn }) or nil
    local baseT = btn.BackgroundTransparency
    local hoverT = o.hoverT or math.max(baseT - 0.12, 0)
    if o.ripple then btn.ClipsDescendants = true end
    btn.MouseEnter:Connect(function() TW(btn, 0.15, { BackgroundTransparency = hoverT }) end)
    btn.MouseLeave:Connect(function()
        TW(btn, 0.2, { BackgroundTransparency = baseT })
        if scale then TW(scale, 0.2, { Scale = 1 }) end
    end)
    btn.InputBegan:Connect(function(i)
        if not isPress(i) then return end
        Sfx.Pop()
        if scale then TW(scale, 0.1, { Scale = o.press or 0.97 }) end
        if o.ripple then Ripple(btn, i.Position, o.rippleAlpha) end
    end)
    btn.InputEnded:Connect(function(i)
        if isPress(i) and scale then TW(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back) end
    end)
end
local function RowHit(c)
    c.ClipsDescendants = true
    local hit = New("TextButton", { Size = UDim2.fromScale(1,1), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, Parent = c })
    local base = c.BackgroundTransparency
    hit.MouseEnter:Connect(function() TW(c, 0.15, { BackgroundTransparency = math.max(base-0.12, 0) }) end)
    hit.MouseLeave:Connect(function() TW(c, 0.2, { BackgroundTransparency = base }) end)
    hit.InputBegan:Connect(function(i) if isPress(i) then Sfx.Pop(); Ripple(c, i.Position, 0.88) end end)
    return hit
end

