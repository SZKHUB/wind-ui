local function rnd(a,b) return a + math.random()*(b-a) end
local function Connect(sig, fn) local c = sig:Connect(fn); table.insert(conns, c); return c end

local function New(cls, props, children)
    local o = Instance.new(cls)
    local parent, theme
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v
        elseif k == "Theme" then theme = v
        else o[k] = v end
    end
    if theme then
        for prop, role in pairs(theme) do
            o[prop] = T[role]
            table.insert(bound, { o, prop, role })
        end
    end
    if o:IsA("GuiObject") and (not props or not props.BorderSizePixel) then
        o.BorderSizePixel = 0
    end
    if (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox"))
        and (not props or not props.TextStrokeTransparency) then
        o.TextStrokeColor3 = Color3.new(0,0,0)
        o.TextStrokeTransparency = textShadowOn and TEXT_SHADOW or 1
        table.insert(textObjs, o)
    end
    for _, c in ipairs(children or {}) do c.Parent = o end
    o.Parent = parent
    return o
end
local function Bind(o, p, r) o[p] = T[r]; table.insert(bound, {o,p,r}) end
local function Cor(o, r) return New("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = o }) end
local function Circle(o) return New("UICorner", { CornerRadius = UDim.new(1,0), Parent = o }) end
local function Stk(o, role, th, tr)
    return New("UIStroke", { Theme = { Color = role or "border" }, Thickness = th or 1,
        Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = o })
end
local function List(o, pad, dir)
    return New("UIListLayout", { FillDirection = dir or Enum.FillDirection.Vertical,
        Padding = UDim.new(0, pad or 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = o })
end
local function Pad(o, t, b, l, r)
    return New("UIPadding", { PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or 0), Parent = o })
end
local function TW(o, t, props, st, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t, st or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
    tw:Play(); return tw
end
local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function isMove(i)  return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end
local function safe(fn, ...)
    if not fn then return end
    local a = table.pack(...)
    task.spawn(function()
        local ok, err = pcall(fn, table.unpack(a, 1, a.n))
        if not ok then warn("[SZK] "..tostring(err)) end
    end)
end
local function safeParent(gui)
    local ok = pcall(function() gui.Parent = (gethui and gethui()) or CoreGui end)
    if not ok or not gui.Parent then gui.Parent = LP:WaitForChild("PlayerGui") end
end
local function cleanup(name)
    pcall(function()
        for _, p in ipairs({ CoreGui, LP:FindFirstChild("PlayerGui") }) do
            local o = p and p:FindFirstChild(name)
            if o then o:Destroy() end
        end
        if gethui then local o = gethui():FindFirstChild(name); if o then o:Destroy() end end
    end)
end

