    local function RefreshTheme()
        local function alive(i) return RootGui and i:IsDescendantOf(RootGui) end
        for i = #Spinners, 1, -1 do if not alive(Spinners[i]) then table.remove(Spinners, i) end end
        for i = #LineGrads, 1, -1 do if not alive(LineGrads[i]) then table.remove(LineGrads, i) end end
        for i = #AccentGrads, 1, -1 do if not alive(AccentGrads[i]) then table.remove(AccentGrads, i) end end

        if not rainbow then
            local bseq = BorderSeq()
            for _, g in ipairs(Spinners) do g.Color = bseq end
        end
        local lseq, aseq = LineSeq(), AccentSeq()
        for _, g in ipairs(LineGrads) do g.Color = lseq end
        for _, g in ipairs(AccentGrads) do g.Color = aseq end

        for i = #ThemeRefs, 1, -1 do
            local r = ThemeRefs[i]
            if not alive(r[1]) then
                table.remove(ThemeRefs, i)
            else
                Tween(r[1], 0.3, { [r[2]] = T[r[3]] })
            end
        end

        SetIconColor(ic, T.Accent, 0.25)
        if Current then SetIconColor(Current.Icon, T.Accent, 0.25) end
        for _, fn in ipairs(ThemeHooks) do pcall(fn) end
    end

