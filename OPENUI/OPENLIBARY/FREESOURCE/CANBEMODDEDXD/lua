local lastPlay = {}
local function playS(base, key, spMin, spMax, vMul)
    if not Sfx.Enabled or not alive then return end
    local now = os.clock()
    if lastPlay[key] and now - lastPlay[key] < 0.04 then return end
    lastPlay[key] = now
    local s = base:Clone()
    s.Volume = Sfx.Volume * (vMul or 1)
    s.PlaybackSpeed = rnd(spMin or 0.96, spMax or 1.08)
    s.Parent = sfxFolder
    s.Ended:Connect(function() s:Destroy() end)
    Debris:AddItem(s, 12)
    s:Play()
end

function Sfx.Pop()   playS(uiSnd,    "pop",   0.95, 1.10, 1.0) end
