local function BrushIcon(size, color)
    local f = New("Frame", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
    New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.62, 0.38),
        Size = UDim2.fromOffset(math.max(2, size * 0.2), size * 0.66), Rotation = 45,
