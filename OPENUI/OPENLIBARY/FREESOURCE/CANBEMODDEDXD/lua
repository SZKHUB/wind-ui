        for _, g in ipairs(Spinners) do g.Rotation = (g.Rotation + dt * 90) % 360 end
        if rainbow then
            local hh = (os.clock() % 8) / 8
            local seq = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHSV(hh, 0.85, 1)),
                ColorSequenceKeypoint.new(0.5, Color3.fromHSV((hh + 0.33) % 1, 0.85, 1)),
                ColorSequenceKeypoint.new(1, Color3.fromHSV(hh, 0.85, 1)),
            })
            for _, g in ipairs(Spinners) do g.Color = seq end
        end
        fpsAcc += dt; fpsN += 1
        if fpsAcc >= 0.5 then
            local fps = math.floor(fpsN / fpsAcc + 0.5)
            fpsAcc, fpsN = 0, 0
            if WM and WM.Visible and WMLabel then
                WMLabel.Text = string.format("%s  |  %d FPS  |  %s", cfg.Title or "OPENUI", fps, os.date("%H:%M"))
