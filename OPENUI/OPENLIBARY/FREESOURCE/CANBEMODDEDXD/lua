    local FOLDER = "OpenUI/configs"
    function Window:SaveConfig(name)
        if not (writefile and makefolder) then return false, "Tu ejecutor no soporta archivos" end
        local data = {}
        for flag, el in pairs(Flags) do
            local val = el:Get()
            if el.Type == "Color" then val = { val.R, val.G, val.B }
            elseif el.Type == "Keybind" then val = val and val.Name or nil end
            data[flag] = { t = el.Type, v = val }
        end
        pcall(makefolder, "OpenUI"); pcall(makefolder, FOLDER)
        local ok, err = pcall(function() writefile(FOLDER .. "/" .. name .. ".json", HttpService:JSONEncode(data)) end)
        return ok, err
    end
    function Window:LoadConfig(name)
        if not (readfile and isfile) then return false, "Tu ejecutor no soporta archivos" end
        local path = FOLDER .. "/" .. name .. ".json"
        if not isfile(path) then return false, "No existe la config '" .. name .. "'" end
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
        if not ok then return false, "Archivo dañado" end
        for flag, item in pairs(data) do
            local el = Flags[flag]
            if el then
                local val = item.v
                if el.Type == "Color" and type(val) == "table" then val = Color3.new(val[1], val[2], val[3])
                elseif el.Type == "Keybind" then
                    local okk, kc = pcall(function() return Enum.KeyCode[val] end)
                    val = okk and kc or nil
                end
                pcall(function() el:Set(val) end)
            end
        end
        return true
    end
    function Window:ListConfigs()
        local out = {}
        if listfiles and isfolder and isfolder(FOLDER) then
            for _, f in ipairs(listfiles(FOLDER)) do
                local n = tostring(f):match("([^/\\]+)%.json$")
                if n then out[#out + 1] = n end
            end
        end
        return out
    end
    function Window:SetAutoLoad(name)
        if not (writefile and makefolder) then return false end
        pcall(makefolder, "OpenUI")
        return pcall(function() writefile("OpenUI/autoload.txt", name or "") end)
    end
    function Window:AutoLoad()
        if not (readfile and isfile) then return false end
        local ok, name = pcall(function()
            if isfile("OpenUI/autoload.txt") then return readfile("OpenUI/autoload.txt") end
        end)
        if ok and name and name ~= "" then return Window:LoadConfig(name) end
        return false
