local function BorderSeq()
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, T.C1),
        ColorSequenceKeypoint.new(0.5, T.C2),
        ColorSequenceKeypoint.new(1, T.C1),
    })
end
local function LineSeq()
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
        ColorSequenceKeypoint.new(0.5, T.C1),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0)),
    })
end
local function AccentSeq()
    local a = T.Accent
    return ColorSequence.new(a, a:Lerp(T.C1, 0.5))
end

local function Corner(r) return New("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function Stroke(color, transparency, thickness)
    return New("UIStroke", { Color = color or T.White, Transparency = transparency or 0.9, Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function BWStroke(thickness)
    local st = New("UIStroke", { Color = T.White, Transparency = 0, Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
    local g = New("UIGradient", { Color = BorderSeq(), Parent = st })
    table.insert(Spinners, g)
    return st
end
local function BWLine(props, vertical)
    props.BackgroundColor3 = T.White
    props.BackgroundTransparency = 0
    props.BorderSizePixel = 0
    local f = New("Frame", props)
    local g = New("UIGradient", { Color = LineSeq(), Rotation = vertical and 90 or 0, Parent = f })
    table.insert(LineGrads, g)
    return f
end
local function AccGrad(parent)
    local g = New("UIGradient", { Color = AccentSeq(), Parent = parent })
    table.insert(AccentGrads, g)
    return g
end
local function List(pad, dir)
    return New("UIListLayout", { Padding = UDim.new(0, pad or 0), FillDirection = dir or Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder })
end
local function Pad(t, r, b, l)
    return New("UIPadding", { PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b), PaddingLeft = UDim.new(0, l) })
end
local function IsPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function IsMove(i) return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end

local function Drag(target, handle)
    local dragging, startPos, origin = false, nil, nil
    Bind(handle.InputBegan, function(i)
        if IsPress(i) then
            dragging, startPos, origin = true, i.Position, target.Position
            local c
            c = i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then dragging = false; c:Disconnect() end
            end)
        end
    end)
    Bind(UIS.InputChanged, function(i)
        if dragging and IsMove(i) then
            local d = i.Position - startPos
            target.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
        end
    end)
end

local function Decimals(step)
    local s = string.format("%.6f", step)
    s = s:gsub("0+$", "")
    local frac = s:match("%.(%d*)")
    return frac and #frac or 0
end
local function Round(v, d) local m = 10 ^ d; return math.floor(v * m + 0.5) / m end

