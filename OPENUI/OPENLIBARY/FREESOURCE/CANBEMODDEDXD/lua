		btnLabel.TextSize = 14
		btnLabel.Font = Enum.Font.GothamSemibold
		btnLabel.LayoutOrder = 2
		btnLabel.Parent = contentContainer2

		button.MouseButton1Click:Connect(function()
			if btnCallback then
				local ok, err = pcall(btnCallback)
				if not ok then warn("GAeroUI Popup Button Error:", err) end
			end
			closePopup()
		end)

		button.MouseEnter:Connect(function()
			CreateTween(button, {BackgroundColor3 = btnVariant == "Primary" and Theme.AccentHover or Theme.AccentColor})
		end)
		button.MouseLeave:Connect(function()
			CreateTween(button, {
				BackgroundColor3 = btnVariant == "Primary" and Theme.AccentColor or
					btnVariant == "Secondary" and Theme.SidebarBackground or Theme.MainBackground
			})
		end)
