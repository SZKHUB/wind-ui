		local btnLabel = Instance.new("TextLabel")
		btnLabel.Size = UDim2.new(0, 0, 0, 0)
		btnLabel.AutomaticSize = Enum.AutomaticSize.XY
		btnLabel.BackgroundTransparency = 1
