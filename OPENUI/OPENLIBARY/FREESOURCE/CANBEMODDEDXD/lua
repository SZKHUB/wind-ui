		container.Parent = self.Window.ContentScroll

		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.BackgroundColor3 = Theme.SidebarBackground
		f.BackgroundTransparency = 0.3
		f.BorderSizePixel = 0
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.Parent = container
		local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0, 10); fc.Parent = f

		local area = Instance.new("Frame")
		area.Size = UDim2.new(1, -24, 0, 0)
		area.Position = UDim2.new(0, 12, 0, 12)
		area.BackgroundTransparency = 1
		area.AutomaticSize = Enum.AutomaticSize.Y
		area.Parent = f
		local al = Instance.new("UIListLayout"); al.SortOrder = Enum.SortOrder.LayoutOrder; al.Padding = UDim.new(0, 10); al.Parent = area

		if thumbnail then
