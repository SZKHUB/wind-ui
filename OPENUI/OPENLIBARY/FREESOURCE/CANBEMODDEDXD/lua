	clbl.TextYAlignment = Enum.TextYAlignment.Top
	clbl.TextWrapped = true
	clbl.AutomaticSize = Enum.AutomaticSize.Y
	clbl.LayoutOrder = 2
	clbl.Parent = area

	local bf = Instance.new("Frame")
	bf.Size = UDim2.new(1, 0, 0, 44)
	bf.BackgroundTransparency = 1
	bf.LayoutOrder = 3
	bf.Parent = area

	local bl = Instance.new("UIListLayout")
	bl.SortOrder = Enum.SortOrder.LayoutOrder
	bl.Padding = UDim.new(0, 8)
	bl.FillDirection = Enum.FillDirection.Horizontal
	bl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	bl.Parent = bf

	local function close()
		CreateTween(overlay, {BackgroundTransparency = 1}, TweenPresets.Fast)
		CreateTween(container, {Size = UDim2.new(0, 400, 0, 0)}, TweenPresets.Fast)
		task.wait(0.2)
		if overlay and overlay.Parent then overlay:Destroy() end
	end

	for i, bc in ipairs(buttons) do
		local variant = bc.Variant or "Primary"
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0, 100, 1, 0)
		b.BackgroundColor3 = variant == "Primary" and Theme.AccentColor or Theme.SidebarBackground
		b.BorderSizePixel = 0
		b.Text = bc.Title or "Button"
		b.TextColor3 = Theme.TextColor
		b.TextSize = 13
		b.Font = Enum.Font.GothamSemibold
		b.AutoButtonColor = false
		b.LayoutOrder = i
		b.Parent = bf

		local bc2 = Instance.new("UICorner")
		bc2.CornerRadius = UDim.new(0, 10)
		bc2.Parent = b

		b.MouseButton1Click:Connect(function()
			if bc.Callback then pcall(bc.Callback) end
			close()
		end)
	end

	task.wait()
	local fh = layout.AbsoluteContentSize.Y + 48
	CreateTween(overlay, {BackgroundTransparency = 0.5}, TweenPresets.Medium)
	CreateTween(container, {Size = UDim2.new(0, 400, 0, fh)}, TweenPresets.Smooth)

	return {Close = close}
end

