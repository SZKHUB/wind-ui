local function Icon(name, size, color, glyph)
    local key = IconAlias[name] or name
    local id = OpenUI.Icons[key]
    if id then
        local src = id
        if type(src) == "number" then src = "rbxassetid://" .. tostring(src) end
        return New("ImageLabel", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, Image = src, ImageColor3 = color, ScaleType = Enum.ScaleType.Fit })
    end
    if key == "brush" then return BrushIcon(size, color) end
    return New("TextLabel", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, Text = glyph or "•", TextSize = size, Font = Enum.Font.GothamBold, TextColor3 = color })
end

local function SetIconColor(ic, col, time)
    if ic:IsA("ImageLabel") then
        Tween(ic, time or 0.15, { ImageColor3 = col })
    elseif ic:IsA("Frame") then
        for _, ch in ipairs(ic:GetChildren()) do
            if ch:IsA("Frame") then Tween(ch, time or 0.15, { BackgroundColor3 = col }) end
        end
    else
        Tween(ic, time or 0.15, { TextColor3 = col })
    end
end

