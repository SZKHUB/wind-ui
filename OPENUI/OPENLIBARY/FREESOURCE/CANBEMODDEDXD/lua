local function Card(parent, order, title, desc, reserve, page)
    local card = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = T.White, BackgroundTransparency = 0.94, LayoutOrder = order, Parent = parent,
    }, { Corner(10), Stroke(T.White, 0.93, 1), Pad(9, 14, 9, 14), List(8) })

    local head = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Parent = card,
    }, { New("UISizeConstraint", { MinSize = Vector2.new(0, 22) }) })

    local texts = New("Frame", {
        Size = UDim2.new(1, -(reserve or 0), 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = head,
    }, { List(2) })

    local t = New("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = title or "",
        Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center, TextWrapped = true, LayoutOrder = 1, Parent = texts,
    }, { New("UISizeConstraint", { MinSize = Vector2.new(0, 22) }) })

    local d = New("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = desc or "",
        Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = T.Dim, TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true, Visible = (desc ~= nil and desc ~= ""), LayoutOrder = 2, Parent = texts,
    })

    if page then table.insert(Searchables, { card = card, t = t, d = d }) end
    return card, head, t, d
end

local function ClickArea(head, card, base)
    base = base or 0.94
    local b = New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 3, Parent = head })
    local st = card:FindFirstChildOfClass("UIStroke")
    b.MouseEnter:Connect(function()
        Tween(card, 0.15, { BackgroundTransparency = base - 0.04 })
        if st then Tween(st, 0.15, { Transparency = 0.8 }) end
    end)
    b.MouseLeave:Connect(function()
        Tween(card, 0.15, { BackgroundTransparency = base })
        if st then Tween(st, 0.15, { Transparency = 0.93 }) end
    end)
    return b
end

local function Common(el, card, t, d)
    function el:SetTitle(s) t.Text = tostring(s) end
    function el:SetDesc(s) d.Text = s or ""; d.Visible = (s ~= nil and s ~= "") end
    function el:SetVisible(v) card.Visible = v end
    function el:Destroy() card:Destroy() end
    return el
end
local function Register(flag, el) if flag then Flags[flag] = el end end

local function KeyChip(parent, right, key, onChange)
    local self = {}
    local chip = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -right, 0.5, 0), Size = UDim2.fromOffset(0, 22),
        AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = T.White, BackgroundTransparency = 0.9, AutoButtonColor = false,
        Text = key and key.Name or "—", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = T.Dim, ZIndex = 5, Parent = parent,
    }, { Corner(6), Pad(0, 8, 0, 8) })
    local listening = false
    chip.MouseButton1Click:Connect(function() listening = true; Listening = true; chip.Text = "..." end)
    Bind(UIS.InputBegan, function(i)
        if listening and i.UserInputType == Enum.UserInputType.Keyboard then
            listening = false
            task.defer(function() Listening = false end)
            key = (i.KeyCode ~= Enum.KeyCode.Escape) and i.KeyCode or nil
            chip.Text = key and key.Name or "—"
            if onChange then task.spawn(onChange, key) end
        end
    end)
    function self.Get() return key end
    function self.Set(k) key = k; chip.Text = key and key.Name or "—" end
    self.Chip = chip
    return self
end

local function Elements(obj, parent, page)
    local order = 0
    local function nx() order += 1; return order end
    local function mk(title, desc, reserve) return Card(parent, nx(), title, desc, reserve, page) end

    function obj:Section(title)
        return New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Text = string.upper(title or ""),
            Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = T.Dim, TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = nx(), Parent = parent,
        })
    end

    function obj:Divider()
        return BWLine({ Size = UDim2.new(1, 0, 0, 1), LayoutOrder = nx(), Parent = parent })
    end

    function obj:Paragraph(c)
        c = c or {}
        local card, _, t, d = mk(c.Title, c.Desc, 0)
        return Common({ Type = "Paragraph" }, card, t, d)
    end
    obj.Label = obj.Paragraph

    function obj:Callout(c)
        c = c or {}
        local style = NOTIF[c.Type or "info"] or NOTIF.info
        local col = style.col or T.Accent
        local card, _, t, d = mk(c.Title, c.Desc, 0)
        card.BackgroundColor3 = col
        card.BackgroundTransparency = 0.88
        local st = card:FindFirstChildOfClass("UIStroke")
        if st then st.Color = col; st.Transparency = 0.6 end
        t.TextColor3 = col
        return Common({ Type = "Callout" }, card, t, d)
    end

    function obj:Group(c)
        c = c or {}
        local open = c.Open ~= false
        local card = New("Frame", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.White,
            BackgroundTransparency = 0.97, LayoutOrder = nx(), Parent = parent,
        }, { Corner(12), Stroke(T.White, 0.94, 1), Pad(6, 6, 6, 6), List(6) })
        local head = New("TextButton", { Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = 1, Parent = card })
        New("TextLabel", {
            Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -36, 1, 0), BackgroundTransparency = 1, Text = string.upper(c.Title or "Grupo"),
            Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = T.Dim, TextXAlignment = Enum.TextXAlignment.Left, Parent = head,
        })
        local chev = Icon("chevron-down", 16, T.Dim, "▾")
        chev.AnchorPoint = Vector2.new(1, 0.5); chev.Position = UDim2.new(1, -8, 0.5, 0); chev.Parent = head
        chev.Rotation = open and 180 or 0
        local body = New("Frame", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
            Visible = open, LayoutOrder = 2, Parent = card,
        }, { List(6) })
        local g = {}
        Elements(g, body, page)
        function g:SetOpen(v) open = v; body.Visible = v; Tween(chev, 0.2, { Rotation = v and 180 or 0 }) end
        head.MouseButton1Click:Connect(function() g:SetOpen(not open) end)
        return g
    end

    function obj:Button(c)
        c = c or {}
        local card, head, t, d = mk(c.Title, c.Desc, 30)
        local base = 0.94
        if c.Style == "Accent" then
            Th(card, "BackgroundColor3", "Accent"); base = 0.72; card.BackgroundTransparency = base
        elseif c.Style == "Danger" then
            card.BackgroundColor3 = Color3.fromRGB(240, 70, 70); base = 0.75; card.BackgroundTransparency = base
        end
        local ic = Icon("chevron-right", 16, T.Dim, "›")
        ic.AnchorPoint = Vector2.new(1, 0.5); ic.Position = UDim2.fromScale(1, 0.5); ic.Parent = head
        local st = card:FindFirstChildOfClass("UIStroke")
        local b = ClickArea(head, card, base)
        b.MouseButton1Down:Connect(function()
            Tween(card, 0.08, { BackgroundTransparency = base - 0.1 })
            if st then Tween(st, 0.08, { Color = T.Accent, Transparency = 0.4 }) end
        end)
        b.MouseButton1Up:Connect(function()
            Tween(card, 0.15, { BackgroundTransparency = base - 0.04 })
            if st then Tween(st, 0.25, { Color = T.White, Transparency = 0.8 }) end
        end)
        local function fire() if c.Callback then task.spawn(c.Callback) end end
        b.MouseButton1Click:Connect(fire)
        local el = { Type = "Button" }
        function el:Fire() fire() end
        return Common(el, card, t, d)
    end

    function obj:Toggle(c)
        c = c or {}
        local bindable = (c.Bindable == true) or (c.Key ~= nil)
        local card, head, tl, dl = mk(c.Title, c.Desc, bindable and 130 or 60)
        local pill = New("Frame", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(42, 22),
            BackgroundColor3 = T.White, BackgroundTransparency = 0.85, Parent = head,
        }, { Corner(11) })
        local pg = AccGrad(pill)
        pg.Enabled = false
        local knob = New("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(16, 16),
            BackgroundColor3 = T.Off, Parent = pill,
        }, { Corner(8) })

        local state = c.Default == true
        local function render(anim)
            local tm = anim and 0.2 or 0
            pg.Enabled = state
            Tween(pill, tm, { BackgroundTransparency = state and 0 or 0.85 })
            Tween(knob, tm, { Position = state and UDim2.new(0, 23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = state and T.White or T.Off }, Back)
        end
        render(false)

        local function set(v, fire)
            state = v and true or false
            render(true)
            if fire and c.Callback then task.spawn(c.Callback, state) end
        end
        ClickArea(head, card).MouseButton1Click:Connect(function() set(not state, true) end)

        local chip
        if bindable then
            chip = KeyChip(head, 50, c.Key)
            Bind(UIS.InputBegan, function(i, gp)
                local k = chip.Get()
                if not gp and not Listening and k and i.KeyCode == k then set(not state, true) end
            end)
        end

        local el = { Type = "Toggle" }
        function el:Set(v) set(v, true) end
        function el:Get() return state end
        function el:SetKey(k) if chip then chip.Set(k) end end
        Common(el, card, tl, dl); Register(c.Flag, el)
        return el
    end

    function obj:Slider(c)
        c = c or {}
        local min, max, step = c.Min or 0, c.Max or 100, c.Step or 1
        local dec = Decimals(step)
        local value = math.clamp(c.Default or min, min, max)
        local suffix = c.Suffix or ""
        local card, head, tl, dl = mk(c.Title, c.Desc, 100)
        local function num(v) return string.format("%." .. dec .. "f", v) end

        local valRow = New("Frame", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(0, 22),
            AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Parent = head,
        }, { New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })
        local valBox = New("TextBox", {
            Size = UDim2.fromOffset(54, 22), BackgroundColor3 = T.White, BackgroundTransparency = 0.92, Text = num(value),
            Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = T.Text, ClearTextOnFocus = false, LayoutOrder = 1, ZIndex = 5, Parent = valRow,
        }, { Corner(6) })
        if suffix ~= "" then
            New("TextLabel", {
                Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Text = suffix,
                Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = T.Dim, LayoutOrder = 2, Parent = valRow,
            })
        end

        local hit = New("Frame", { Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, LayoutOrder = 2, Parent = card })
        local track = New("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 6),
            BackgroundColor3 = T.White, BackgroundTransparency = 0.88, Parent = hit,
        }, { Corner(3) })
        local fill = New("Frame", { Size = UDim2.fromScale((value - min) / (max - min), 1), BackgroundColor3 = T.White, Parent = track }, { Corner(3) })
        AccGrad(fill)
        local knobStroke = Stroke(T.Accent, 0, 2)
        Th(knobStroke, "Color", "Accent")
        local knob = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(14, 14),
            BackgroundColor3 = T.White, Parent = fill,
        }, { Corner(7), knobStroke })

        local function set(v, fire)
            v = math.clamp(Round(math.floor((v - min) / step + 0.5) * step + min, dec), min, max)
            valBox.Text = num(v)
            if v == value then return end
            value = v
            Tween(fill, 0.08, { Size = UDim2.fromScale((value - min) / (max - min), 1) })
            if fire and c.Callback then task.spawn(c.Callback, value) end
        end
        valBox.FocusLost:Connect(function()
            local n = tonumber(valBox.Text)
            if n then set(n, true) else valBox.Text = num(value) end
        end)
        local function fromX(x)
            local w = track.AbsoluteSize.X
            if w <= 0 then return end
            set(min + (max - min) * math.clamp((x - track.AbsolutePosition.X) / w, 0, 1), true)
        end

        local dragging = false
        hit.InputBegan:Connect(function(i)
            if IsPress(i) then
                dragging = true
                Tween(knob, 0.12, { Size = UDim2.fromOffset(18, 18) })
                fromX(i.Position.X)
            end
        end)
        Bind(UIS.InputChanged, function(i) if dragging and IsMove(i) then fromX(i.Position.X) end end)
        Bind(UIS.InputEnded, function(i)
            if dragging and IsPress(i) then
                dragging = false
                Tween(knob, 0.12, { Size = UDim2.fromOffset(14, 14) })
            end
        end)

        local el = { Type = "Slider" }
        function el:Set(v) set(v, true) end
        function el:Get() return value end
        Common(el, card, tl, dl); Register(c.Flag, el)
        return el
    end

    function obj:ProgressBar(c)
        c = c or {}
        local min, max = c.Min or 0, c.Max or 100
        local value = math.clamp(c.Default or min, min, max)
        local card, head, tl, dl = mk(c.Title, c.Desc, 60)
        local valL = New("TextLabel", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(54, 18),
            BackgroundTransparency = 1, Text = "0%", Font = Enum.Font.GothamMedium, TextSize = 12,
            TextColor3 = T.Dim, TextXAlignment = Enum.TextXAlignment.Right, Parent = head,
        })
        local track = New("Frame", { Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = T.White, BackgroundTransparency = 0.88, LayoutOrder = 2, Parent = card }, { Corner(3) })
        local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.White, Parent = track }, { Corner(3) })
        AccGrad(fill)
        local function set(v)
            value = math.clamp(v, min, max)
            local p = (max > min) and (value - min) / (max - min) or 0
            Tween(fill, 0.25, { Size = UDim2.fromScale(p, 1) })
            valL.Text = math.floor(p * 100 + 0.5) .. "%"
        end
        set(value)
        local el = { Type = "ProgressBar" }
        function el:Set(v) set(v) end
        function el:Get() return value end
        return Common(el, card, tl, dl)
    end

    function obj:Dropdown(c)
        c = c or {}
        local values = c.Values or {}
        local multi = c.Multi == true
        local selected
        if multi then
            selected = {}
            if type(c.Default) == "table" then for _, v in ipairs(c.Default) do selected[v] = true end end
        else
            selected = c.Default or values[1]
        end
        local card, head, tl, dl = mk(c.Title, c.Desc, 170)

        local function isSel(v) if multi then return selected[v] == true end return selected == v end
        local function getList()
            local out = {}
            for _, v in ipairs(values) do if selected[v] then out[#out + 1] = v end end
            return out
        end
        local function label()
            if multi then
                local l = getList()
                return #l > 0 and table.concat(l, ", ") or "Ninguno"
            end
            return tostring(selected or "—")
        end

        local valL = New("TextLabel", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -22, 0.5, 0), Size = UDim2.fromOffset(140, 18),
            BackgroundTransparency = 1, Text = label(), Font = Enum.Font.GothamMedium, TextSize = 12,
            TextColor3 = T.Dim, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, Parent = head,
        })
        local chev = Icon("chevron-down", 16, T.Dim, "▾")
        chev.AnchorPoint = Vector2.new(0.5, 0.5); chev.Position = UDim2.new(1, -8, 0.5, 0); chev.Parent = head

        local panel = New("Frame", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
            Visible = false, LayoutOrder = 2, Parent = card,
        }, { List(5) })

        local searchBox
        if #values > 7 then
            searchBox = New("TextBox", {
                Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = T.White, BackgroundTransparency = 0.92, Text = "",
                PlaceholderText = "Buscar...", PlaceholderColor3 = T.Dim, Font = Enum.Font.GothamMedium, TextSize = 12,
                TextColor3 = T.Text, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, Parent = panel,
            }, { Corner(7), Pad(0, 8, 0, 8) })
        end

        local listF = New("ScrollingFrame", {
            Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2,
            ScrollBarImageColor3 = T.Dim, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), LayoutOrder = 2, Parent = panel,
        }, { List(4) })

        local open = false
        local function setOpen(v)
            open = v
            panel.Visible = v
            Tween(chev, 0.2, { Rotation = v and 180 or 0 })
        end

        local optionBtns = {}
        local function paint()
            for v, b in pairs(optionBtns) do b.TextColor3 = isSel(v) and T.Accent or T.Text end
        end
        local function choose(v, fire)
            if multi then
                if selected[v] then selected[v] = nil else selected[v] = true end
            else
                selected = v
            end
            valL.Text = label()
            paint()
            if fire and c.Callback then task.spawn(c.Callback, multi and getList() or v) end
        end
        local function build()
            for _, b in pairs(optionBtns) do b:Destroy() end
            optionBtns = {}
            listF.Size = UDim2.new(1, 0, 0, math.min(#values * 32, 160))
            for idx, v in ipairs(values) do
                local b = New("TextButton", {
                    Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = T.White, BackgroundTransparency = 0.95, AutoButtonColor = false,
                    Text = tostring(v), Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = isSel(v) and T.Accent or T.Text,
                    LayoutOrder = idx, Parent = listF,
                }, { Corner(8) })
                b.MouseEnter:Connect(function() Tween(b, 0.12, { BackgroundTransparency = 0.88 }) end)
                b.MouseLeave:Connect(function() Tween(b, 0.12, { BackgroundTransparency = 0.95 }) end)
                b.MouseButton1Click:Connect(function()
                    choose(v, true)
                    if not multi then setOpen(false) end
                end)
                optionBtns[v] = b
            end
        end
        build()
        if searchBox then
            searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                local q = string.lower(searchBox.Text)
                for v, b in pairs(optionBtns) do
                    b.Visible = (q == "") or (string.find(string.lower(tostring(v)), q, 1, true) ~= nil)
                end
            end)
        end
        OnTheme(paint)
        ClickArea(head, card).MouseButton1Click:Connect(function() setOpen(not open) end)

        local el = { Type = "Dropdown" }
        function el:Set(v)
            if multi then
                selected = {}
                if type(v) == "table" then for _, x in ipairs(v) do selected[x] = true end end
                valL.Text = label(); paint()
                if c.Callback then task.spawn(c.Callback, getList()) end
            else
                choose(v, true)
            end
        end
        function el:Get() if multi then return getList() end return selected end
        function el:Refresh(newValues)
            values = newValues or {}
            if multi then
                for k in pairs(selected) do
                    if not table.find(values, k) then selected[k] = nil end
                end
            elseif not table.find(values, selected) then
                selected = values[1]
            end
            valL.Text = label()
            build()
        end
        Common(el, card, tl, dl); Register(c.Flag, el)
        return el
    end

    function obj:Keybind(c)
        c = c or {}
        local card, head, tl, dl = mk(c.Title, c.Desc, 110)
        local kc = KeyChip(head, 0, c.Default, c.OnChange)
        Bind(UIS.InputBegan, function(i, gp)
            local k = kc.Get()
            if not gp and not Listening and k and i.KeyCode == k and c.Callback then task.spawn(c.Callback, k) end
        end)
        local el = { Type = "Keybind" }
        function el:Get() return kc.Get() end
        function el:Set(k)
            kc.Set(k)
            if c.OnChange then task.spawn(c.OnChange, k) end
        end
        Common(el, card, tl, dl); Register(c.Flag, el)
        return el
    end

    function obj:Input(c)
        c = c or {}
        local card, head, tl, dl = mk(c.Title, c.Desc, 170)
        local box = New("TextBox", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(160, 26),
            BackgroundColor3 = T.White, BackgroundTransparency = 0.9, Text = c.Default or "", PlaceholderText = c.Placeholder or "Escribe...",
            PlaceholderColor3 = T.Dim, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = T.Text, ClearTextOnFocus = false,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = head,
        }, { Corner(6), Pad(0, 8, 0, 8) })
        if c.Numeric then
            box:GetPropertyChangedSignal("Text"):Connect(function()
                local f = box.Text:gsub("[^%d%.%-]", "")
                if f ~= box.Text then box.Text = f end
            end)
        end
        box.FocusLost:Connect(function(enter) if c.Callback then task.spawn(c.Callback, box.Text, enter) end end)

        local el = { Type = "Input" }
        function el:Get() return box.Text end
        function el:Set(v) box.Text = tostring(v or ""); if c.Callback then task.spawn(c.Callback, box.Text, false) end end
        Common(el, card, tl, dl); Register(c.Flag, el)
        return el
    end

    function obj:ColorPicker(c)
        c = c or {}
        local color = c.Default or Color3.fromRGB(255, 255, 255)
        local h, s, v = color:ToHSV()
        local card, head, tl, dl = mk(c.Title, c.Desc, 50)

        local sw = New("Frame", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(34, 20),
            BackgroundColor3 = color, Parent = head,
        }, { Corner(6), Stroke(T.White, 0.7, 1) })

        local panel = New("Frame", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
            Visible = false, LayoutOrder = 2, Parent = card,
        }, { List(8) })

        local sv = New("Frame", { Size = UDim2.new(1, 0, 0, 110), BackgroundColor3 = Color3.fromHSV(h, 1, 1), BorderSizePixel = 0, LayoutOrder = 1, Parent = panel }, { Corner(6) })
        New("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 2, Parent = sv,
        }, { Corner(6), New("UIGradient", { Transparency = NumberSequence.new(0, 1) }) })
        New("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 3, Parent = sv,
        }, { Corner(6), New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }) })
        local svCur = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(s, 1 - v), Size = UDim2.fromOffset(10, 10),
            BackgroundTransparency = 1, ZIndex = 4, Parent = sv,
        }, { Corner(5), Stroke(Color3.new(1, 1, 1), 0, 2) })

        local hue = New("Frame", { Size = UDim2.new(1, 0, 0, 12), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, LayoutOrder = 2, Parent = panel }, {
            Corner(6),
            New("UIGradient", { Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
            }) }),
        })
        local hueCur = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(h, 0.5), Size = UDim2.fromOffset(6, 16),
            BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 2, Parent = hue,
        }, { Corner(3), Stroke(Color3.new(0, 0, 0), 0.5, 1) })

        local hex = New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Text = "#" .. color:ToHex(), Font = Enum.Font.GothamMedium,
            TextSize = 11, TextColor3 = T.Dim, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 3, Parent = panel,
        })

        local function apply(fire)
            color = Color3.fromHSV(h, s, v)
            sw.BackgroundColor3 = color
            sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            svCur.Position = UDim2.fromScale(s, 1 - v)
            hueCur.Position = UDim2.fromScale(h, 0.5)
            hex.Text = "#" .. color:ToHex()
            if fire and c.Callback then task.spawn(c.Callback, color) end
        end
        local function updSV(pos)
            local a, sz = sv.AbsolutePosition, sv.AbsoluteSize
            if sz.X <= 0 or sz.Y <= 0 then return end
            s = math.clamp((pos.X - a.X) / sz.X, 0, 1)
            v = 1 - math.clamp((pos.Y - a.Y) / sz.Y, 0, 1)
            apply(true)
        end
        local function updH(pos)
            local a, sz = hue.AbsolutePosition, hue.AbsoluteSize
            if sz.X <= 0 then return end
            h = math.clamp((pos.X - a.X) / sz.X, 0, 1)
            apply(true)
        end
        local dSV, dH = false, false
        sv.InputBegan:Connect(function(i) if IsPress(i) then dSV = true; updSV(i.Position) end end)
        hue.InputBegan:Connect(function(i) if IsPress(i) then dH = true; updH(i.Position) end end)
        Bind(UIS.InputChanged, function(i)
            if IsMove(i) then
                if dSV then updSV(i.Position) elseif dH then updH(i.Position) end
            end
        end)
        Bind(UIS.InputEnded, function(i) if IsPress(i) then dSV = false; dH = false end end)

        local open = false
        ClickArea(head, card).MouseButton1Click:Connect(function() open = not open; panel.Visible = open end)

        local el = { Type = "Color" }
        function el:Get() return color end
        function el:Set(col)
            if typeof(col) ~= "Color3" then return end
            h, s, v = col:ToHSV()
            apply(true)
        end
        Common(el, card, tl, dl); Register(c.Flag, el)
        return el
    end
end

