				valLbl.Text = tostring(math.floor(defaultValue))
				valLbl.TextColor3 = Theme.TextSecondary
				valLbl.TextSize = 12
				valLbl.Font = Enum.Font.Gotham
				valLbl.TextXAlignment = Enum.TextXAlignment.Right
				valLbl.ZIndex = 502
				valLbl.Parent = picker

				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, 0, 1, 0)
				btn.BackgroundTransparency = 1
				btn.Text = ""
				btn.ZIndex = 504
				btn.Parent = track

				local dragging = false
				local function applyFromX(x)
					local tx = track.AbsolutePosition.X
					local tw = math.max(track.AbsoluteSize.X, 1)
					local p = math.clamp((x - tx) / tw, 0, 1)
					fill.Size = UDim2.new(p, 0, 1, 0)
					valLbl.Text = tostring(math.floor(p * 255))
				end

				btn.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = true
						applyFromX(input.Position.X)
					end
				end)
				btn.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = false
					end
				end)
