local function derive(accH, bgH, lightH, secH, danger)
    local acc   = Color3.fromHex(accH)
    local bg    = Color3.fromHex(bgH)
    local light = Color3.fromHex(lightH)
    local sec   = secH and Color3.fromHex(secH) or light
    return {
        acc = acc, sec = sec, bg = bg,
        panel = bg:Lerp(acc, 0.08), panel2 = bg:Lerp(acc, 0.20),
        card = bg:Lerp(light, 0.12), border = bg:Lerp(acc, 0.50),
        edge = light:Lerp(acc, 0.35), text = light, muted = light:Lerp(bg, 0.30),
        danger = danger,
        Accent = acc, Background = bg, ElementBackground = bg:Lerp(light, 0.12),
        Outline = bg:Lerp(acc, 0.50), Text = light, Placeholder = light:Lerp(bg, 0.30),
        Toggle = acc, Slider = acc, Icon = acc,
    }
end

