				fill.BackgroundColor3 = (name == "R" and Color3.fromRGB(231, 76, 60))
					or (name == "G" and Color3.fromRGB(46, 204, 113))
					or Color3.fromRGB(52, 152, 219)
				fill.BorderSizePixel = 0
				fill.ZIndex = 503
				fill.Parent = track
				local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(1, 0); fc.Parent = fill

