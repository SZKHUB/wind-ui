		l.TextSize = 14
		l.Font = Enum.Font.GothamSemibold
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.Parent = f

		local vl = Instance.new("TextLabel")
		vl.Size = UDim2.new(0, 60, 0, 18)
		vl.Position = UDim2.new(1, -72, 0, 8)
		vl.BackgroundTransparency = 1
		vl.Text = tostring(math.floor(defaultValue))
		vl.TextColor3 = Theme.AccentColor
		vl.TextSize = 14
		vl.Font = Enum.Font.GothamBold
		vl.TextXAlignment = Enum.TextXAlignment.Right
		vl.Parent = f

		local track = Instance.new("Frame")
		track.Size = UDim2.new(1, -24, 0, 6)
		track.Position = UDim2.new(0, 12, 1, -16)
		track.BackgroundColor3 = Theme.ToggleOff
		track.BorderSizePixel = 0
		track.Parent = f

		local tc = Instance.new("UICorner")
		tc.CornerRadius = UDim.new(1, 0)
		tc.Parent = track

		local fill = Instance.new("Frame")
		fill.Size = UDim2.new((defaultValue - min) / (max - min), 0, 1, 0)
		fill.BackgroundColor3 = Theme.AccentColor
		fill.BorderSizePixel = 0
		fill.Parent = track

		local fcc = Instance.new("UICorner")
		fcc.CornerRadius = UDim.new(1, 0)
		fcc.Parent = fill

		local thumb = Instance.new("Frame")
		thumb.Size = UDim2.new(0, 16, 0, 16)
		thumb.Position = UDim2.new((defaultValue - min) / (max - min), -8, 0.5, -8)
		thumb.BackgroundColor3 = Theme.TextColor
		thumb.BorderSizePixel = 0
		thumb.Parent = track

		local thc = Instance.new("UICorner")
		thc.CornerRadius = UDim.new(1, 0)
		thc.Parent = thumb

		local currentValue = defaultValue
		local dragging = false

		local function update(value)
			value = math.clamp(value, min, max)
			currentValue = value
			local p = (value - min) / (max - min)
			CreateTween(fill, {Size = UDim2.new(p, 0, 1, 0)}, TweenPresets.Fast)
			CreateTween(thumb, {Position = UDim2.new(p, -8, 0.5, -8)}, TweenPresets.Fast)
			vl.Text = (math.abs(value - math.floor(value)) > 0.001) and string.format("%.1f", value) or tostring(math.floor(value))
			if callback then pcall(callback, value) end
		end

		local function valFromX(x)
			local tx = track.AbsolutePosition.X
			local tw = math.max(track.AbsoluteSize.X, 1)
			local p = math.clamp((x - tx) / tw, 0, 1)
			return min + p * (max - min)
		end

		local inputConn = UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				update(valFromX(input.Position.X))
			end
		end)
		container.Destroying:Connect(function() if inputConn then inputConn:Disconnect() end end)

		track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				update(valFromX(input.Position.X))
			end
		end)
		track.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)

		add(container, "Slider")
		return {
			Container = container,
			SetValue = update,
			GetValue = function() return currentValue end
		}
	end

