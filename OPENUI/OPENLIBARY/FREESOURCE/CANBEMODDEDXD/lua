			th.BorderSizePixel = 0
			th.Image = thumbnail
			th.ScaleType = Enum.ScaleType.Crop
			th.LayoutOrder = 1
			th.Parent = area
			local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(0, 8); tc.Parent = th
		end

		local h = Instance.new("Frame")
		h.Size = UDim2.new(1, 0, 0, 24)
		h.BackgroundTransparency = 1
		h.LayoutOrder = 2
		h.Parent = area

		if image then
			local ic = Instance.new("Frame")
			ic.Size = UDim2.new(0, config.ImageSize or 22, 0, config.ImageSize or 22)
			ic.BackgroundTransparency = 1
			ic.Parent = h
			if image:match("^lucide%-") then
				LoadLucideIcon(image:gsub("^lucide%-", ""), ic, iconThemed and Theme.AccentColor or Theme.TextColor)
			else
				local i = Instance.new("ImageLabel")
				i.Size = UDim2.new(1, 0, 1, 0)
				i.BackgroundTransparency = 1
				i.Image = image
				i.ImageColor3 = iconThemed and Theme.AccentColor or Theme.TextColor
				i.Parent = ic
			end
		end

		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.new(1, image and -30 or 0, 1, 0)
		tl.Position = UDim2.new(0, image and 30 or 0, 0, 0)
		tl.BackgroundTransparency = 1
		tl.Text = title
		tl.TextColor3 = Theme.TextColor
		tl.TextSize = 16
		tl.Font = Enum.Font.GothamBold
		tl.TextXAlignment = Enum.TextXAlignment.Left
		tl.Parent = h

		if desc ~= "" then
			local dl = Instance.new("TextLabel")
			dl.Size = UDim2.new(1, 0, 0, 0)
			dl.BackgroundTransparency = 1
			dl.Text = desc
			dl.TextColor3 = Theme.TextSecondary
			dl.TextSize = 13
			dl.Font = Enum.Font.Gotham
			dl.TextXAlignment = Enum.TextXAlignment.Left
			dl.TextYAlignment = Enum.TextYAlignment.Top
			dl.TextWrapped = true
			dl.AutomaticSize = Enum.AutomaticSize.Y
			dl.LayoutOrder = 3
			dl.Parent = area
		end

		add(container, "Paragraph")
		return {Container = container}
	end

	function TabMethods:AddSection(config)
		if self.Window.IsDestroyed then return nil end
		config = config or {}
		local title = config.Title or "Section"
		local opened = config.Opened ~= false

		local container = Instance.new("Frame")
		container.Size = UDim2.new(1, 0, 0, 0)
		container.BackgroundTransparency = 1
		container.Visible = (self.Window.CurrentTab == self)
		container.AutomaticSize = Enum.AutomaticSize.Y
		container.Parent = self.Window.ContentScroll

		local l = Instance.new("UIListLayout")
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Padding = UDim.new(0, 8)
		l.Parent = container

		local headerButton = Instance.new("TextButton")
		headerButton.Size = UDim2.new(1, 0, 0, 36)
		headerButton.BackgroundColor3 = Theme.SidebarBackground
		headerButton.BackgroundTransparency = 0.5
		headerButton.BorderSizePixel = 0
		headerButton.Text = ""
		headerButton.AutoButtonColor = false
		headerButton.LayoutOrder = 1
		headerButton.Parent = container

		local hc = Instance.new("UICorner"); hc.CornerRadius = UDim.new(0, 10); hc.Parent = headerButton

		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.new(1, -40, 1, 0)
		tl.Position = UDim2.new(0, 12, 0, 0)
		tl.BackgroundTransparency = 1
		tl.Text = title
		tl.TextColor3 = Theme.AccentColor
		tl.TextSize = 15
		tl.Font = Enum.Font.GothamBold
		tl.TextXAlignment = Enum.TextXAlignment.Left
		tl.Parent = headerButton

		local arrow = Instance.new("Frame")
		arrow.Size = UDim2.new(0, 16, 0, 16)
		arrow.Position = UDim2.new(1, -28, 0.5, -8)
		arrow.BackgroundTransparency = 1
		arrow.Rotation = opened and 0 or -90
		arrow.Parent = headerButton
		LoadLucideIcon("chevron-down", arrow, Theme.TextSecondary)

		local contentContainer = Instance.new("Frame")
		contentContainer.Size = UDim2.new(1, 0, 0, 0)
		contentContainer.BackgroundTransparency = 1
		contentContainer.Visible = opened
		contentContainer.AutomaticSize = Enum.AutomaticSize.Y
		contentContainer.LayoutOrder = 2
		contentContainer.Parent = container

		local cl = Instance.new("UIListLayout")
		cl.SortOrder = Enum.SortOrder.LayoutOrder
		cl.Padding = UDim.new(0, 8)
		cl.Parent = contentContainer

		headerButton.MouseButton1Click:Connect(function()
			opened = not opened
			contentContainer.Visible = opened
			CreateTween(arrow, {Rotation = opened and 0 or -90}, TweenPresets.Fast)
		end)

		add(container, "Section")

		-- ✅ Fix: share Elements and make (Window.CurrentTab == self) true inside the section
		local SectionMethods = setmetatable({}, {__index = self})
		SectionMethods.Elements = self.Elements
		SectionMethods.ContentContainer = contentContainer

		local sectionProxy = setmetatable({}, {
			__index = function(_, key)
				if key == "ContentScroll" then
					return contentContainer
				elseif key == "CurrentTab" then
					local cur = self.Window.CurrentTab
					if cur == self then return SectionMethods end
					return cur
				end
				return self.Window[key]
			end
		})
		SectionMethods.Window = sectionProxy

		return SectionMethods
	end

	function TabMethods:AddKeybind(text, defaultKey, callback)
		if self.Window.IsDestroyed then return nil end
		defaultKey = defaultKey or "F"

		local container = Instance.new("Frame")
		container.Size = UDim2.new(1, 0, 0, 44)
		container.BackgroundTransparency = 1
		container.Visible = (self.Window.CurrentTab == self)
		container.Parent = self.Window.ContentScroll

		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 1, 0)
		f.BackgroundColor3 = Theme.SidebarBackground
		f.BorderSizePixel = 0
		f.Parent = container
		local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0, 10); fc.Parent = f

		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, -100, 1, 0)
		l.Position = UDim2.new(0, 12, 0, 0)
		l.BackgroundTransparency = 1
		l.Text = text
		l.TextColor3 = Theme.TextColor
		l.TextSize = 14
		l.Font = Enum.Font.GothamSemibold
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.Parent = f

		local currentKey = defaultKey
		local isBinding = false

		local kb = Instance.new("TextButton")
		kb.Size = UDim2.new(0, 80, 0, 32)
		kb.Position = UDim2.new(1, -92, 0.5, -16)
		kb.BackgroundColor3 = Theme.ToggleOff
		kb.BorderSizePixel = 0
		kb.Text = ""
		kb.AutoButtonColor = false
		kb.Parent = f
		local kbc = Instance.new("UICorner"); kbc.CornerRadius = UDim.new(0, 8); kbc.Parent = kb

		local kl = Instance.new("TextLabel")
		kl.Size = UDim2.new(1, -16, 1, 0)
		kl.Position = UDim2.new(0, 8, 0, 0)
		kl.BackgroundTransparency = 1
		kl.Text = currentKey
		kl.TextColor3 = Theme.TextColor
		kl.TextSize = 13
		kl.Font = Enum.Font.GothamBold
		kl.Parent = kb

		local inputConn
		local function stopBinding()
			isBinding = false
			kl.Text = currentKey
			CreateTween(kb, {BackgroundColor3 = Theme.ToggleOff})
			if inputConn then inputConn:Disconnect(); inputConn = nil end
		end

		kb.MouseButton1Click:Connect(function()
			if isBinding then
				stopBinding()
			else
				isBinding = true
				kl.Text = "..."
				CreateTween(kb, {BackgroundColor3 = Theme.AccentColor})
				inputConn = UserInputService.InputBegan:Connect(function(input, gp)
					if gp then return end
					if input.UserInputType == Enum.UserInputType.Keyboard then
						local name = input.KeyCode.Name
						if name:match("Shift") or name:match("Control") or name:match("Alt") then return end
						currentKey = name
						stopBinding()
						if callback then pcall(callback, name) end
					elseif input.UserInputType == Enum.UserInputType.MouseButton1
						or input.UserInputType == Enum.UserInputType.MouseButton2 then
						stopBinding()
					end
				end)
			end
		end)

		add(container, "Keybind")
		return {
			Container = container,
			SetKey = function(k) currentKey = k; kl.Text = k; if callback then pcall(callback, k) end end,
			GetKey = function() return currentKey end
		}
	end

	return TabMethods
end

-- ============================================================
-- NAVIGATION SHORTCUT
-- ============================================================
function Window:CreateNavigationShortcut(config)
	if self.IsDestroyed then return nil end
	config = config or {}
	local onStart, onPause, onStop = config.OnStart, config.OnPause, config.OnStop
	local initialPosition = config.Position or UDim2.new(0.5, 0, 0.85, 0)

	local shortcut = {
		Enabled = false,
		ScreenGui = nil,
		Frame = nil,
		Connections = {}
	}

	function shortcut:Create()
		if self.ScreenGui then return end
		local isMobile = IsMobileDevice()
		local mobileScale = GetMobileScale()

		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "GAeroUI_NavigationShortcut"
		screenGui.ResetOnSpawn = false
		screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		screenGui.DisplayOrder = 50
		screenGui.Parent = game:GetService("CoreGui")
		self.ScreenGui = screenGui

		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(0, isMobile and 160 or 180, 0, isMobile and 50 or 56)
		frame.Position = initialPosition
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.BackgroundColor3 = Theme.SidebarBackground
		frame.BackgroundTransparency = 0.5
		frame.BorderSizePixel = 0
		frame.Parent = screenGui
		self.Frame = frame

		if isMobile then
			local s = Instance.new("UIScale"); s.Scale = mobileScale; s.Parent = frame
		end

		local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0, 12); fc.Parent = frame

		local bc = Instance.new("Frame")
		bc.Size = UDim2.new(1, -16, 1, -16)
		bc.Position = UDim2.new(0, 8, 0, 8)
		bc.BackgroundTransparency = 1
		bc.Parent = frame

		local bl = Instance.new("UIListLayout")
		bl.FillDirection = Enum.FillDirection.Horizontal
		bl.HorizontalAlignment = Enum.HorizontalAlignment.Center
		bl.VerticalAlignment = Enum.VerticalAlignment.Center
		bl.Padding = UDim.new(0, 8)
		bl.Parent = bc

		local bs = isMobile and 40 or 44
		local function makeBtn(order, color, iconName, cb)
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(0, bs, 0, bs)
			b.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
			b.BackgroundTransparency = 0.3
			b.BorderSizePixel = 0
			b.Text = ""
			b.AutoButtonColor = false
			b.LayoutOrder = order
			b.Parent = bc
			local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 10); c.Parent = b
			local s = Instance.new("UIStroke"); s.Color = color; s.Transparency = 0.7; s.Thickness = 1.5; s.Parent = b
			local ic = Instance.new("Frame")
			ic.Size = UDim2.new(0, 22, 0, 22)
			ic.Position = UDim2.new(0.5, -11, 0.5, -11)
			ic.BackgroundTransparency = 1
			ic.Parent = b
			LoadLucideIcon(iconName, ic, color)
			b.MouseButton1Click:Connect(function() if cb then pcall(cb) end end)
			return b
		end

		makeBtn(1, Theme.SuccessColor, "play", onStart)
		makeBtn(2, Theme.WarningColor, "pause", onPause)
		makeBtn(3, Theme.ErrorColor, "square", onStop)

		-- draggable
		local dragging, dragInput, dragStart, startPos
		frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = frame.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then dragging = false end
				end)
			end
		end)
		frame.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)
		self.Connections.DragInput = UserInputService.InputChanged:Connect(function(input)
			if input == dragInput and dragging then
				local d = input.Position - dragStart
				frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end)

		self.Enabled = true
	end

	function shortcut:Destroy()
		for _, conn in pairs(self.Connections) do
			if conn and typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
		end
		self.Connections = {}
		if self.ScreenGui then self.ScreenGui:Destroy(); self.ScreenGui = nil end
		self.Frame = nil
		self.Enabled = false
	end

	function shortcut:Show() self:Create() end
	function shortcut:Hide() if self.ScreenGui then self.ScreenGui.Enabled = false end end
	function shortcut:UpdateCallbacks(c)
		if c.OnStart then onStart = c.OnStart end
		if c.OnPause then onPause = c.OnPause end
		if c.OnStop then onStop = c.OnStop end
	end

	return shortcut
end

return Library
