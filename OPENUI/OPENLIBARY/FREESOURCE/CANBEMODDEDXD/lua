	task.wait()
	local finalHeight = contentLayout.AbsoluteContentSize.Y + 40
	popupContainer.Size = UDim2.new(0, 420, 0, 0)
	CreateTween(popupOverlay, {BackgroundTransparency = 0.5}, TweenPresets.Medium)
	CreateTween(popupContainer, {Size = UDim2.new(0, 420, 0, finalHeight)}, TweenPresets.Smooth)

	return { Close = closePopup }
