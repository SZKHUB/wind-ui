    local map = { Success="success", Error="error", Warning="warn", Info="info" }
    Notify(cfg.Title or "Notice", cfg.Content or cfg.Text or "", cfg.Duration or 4,
        map[cfg.Type] or (cfg.Type and cfg.Type:lower()) or "info", cfg.Buttons)
end
function SZK:Success(t,c,d) return self:Notify({Title=t or "Success", Content=c or "", Type="Success", Duration=d or 3}) end
function SZK:Error(t,c,d)   return self:Notify({Title=t or "Error",   Content=c or "", Type="Error",   Duration=d or 3.5}) end
function SZK:Warn(t,c,d)    return self:Notify({Title=t or "Warning", Content=c or "", Type="Warning", Duration=d or 3}) end
