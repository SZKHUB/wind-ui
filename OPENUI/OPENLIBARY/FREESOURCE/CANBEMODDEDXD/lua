function SZK:CreateSettingsTab(window, tabName, tabIcon)
    tabName = tabName or "Settings"
    tabIcon = tabIcon or "settings"
    local tab = window:CreateTab(tabName, tabIcon)

    local secUI = tab:CreateSection("Interface")
    local themeNames = {}
    for _, n in ipairs(SZK.ThemeOrder) do table.insert(themeNames, n) end
    secUI:CreateDropdown({
        Name = "Theme", Options = themeNames, Default = currentThemeName,
        Callback = function(v) applyThemeByName(v) end,
    })
    secUI:CreateToggle({
        Name = "Text Shadow", Default = textShadowOn,
        Callback = function(v) setTextShadow(v) end,
    })
    secUI:CreateToggle({
        Name = "Background Blur", Default = blurEnabled,
        Callback = function(v) SZK:SetBlurEnabled(v) end,
    })

    local secSound = tab:CreateSection("Sound")
    secSound:CreateToggle({
        Name = "UI Sounds", Default = Sfx.Enabled,
        Callback = function(v) Sfx.Enabled = v end,
    })
    secSound:CreateSlider({
        Name = "Volume", Min = 0, Max = 100, Default = math.floor(Sfx.Volume*100+0.5), Suffix = "%",
        Callback = function(v) Sfx.Volume = v/100 end,
    })
    secSound:CreateButton({
        Name = "Test Pop", Callback = function() Sfx.Pop() end,
    })
    secSound:CreateButton({
        Name = "Test Notification", Callback = function()
            Notify("Success", "Test notification working ✓", 4, "success",
                { { text = "OK", cb = function() end } })
        end,
    })

    return tab
end

