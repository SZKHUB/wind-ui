				if hasTransparency and aS then
					currentTransparency = 1 - (aS.GetValue() / 255)
					preview.BackgroundTransparency = currentTransparency
				end
				preview.BackgroundColor3 = currentColor
				if callback then pcall(callback, currentColor, currentTransparency) end
				closePicker()
			end)

