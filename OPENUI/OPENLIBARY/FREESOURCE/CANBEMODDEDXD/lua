local function setTextShadow(v)
    textShadowOn = v and true or false
    for i = #textObjs, 1, -1 do
        local o = textObjs[i]
        if o.Parent == nil then
            table.remove(textObjs, i)
        else
            o.TextStrokeTransparency = textShadowOn and TEXT_SHADOW or 1
        end
    end
end
function SZK:SetTextShadow(v) setTextShadow(v) end
function SZK:GetTextShadow() return textShadowOn end
function SZK:ToggleTextShadow() setTextShadow(not textShadowOn) return textShadowOn end

