		if self.Window.IsDestroyed then return nil end
		min = min or 0
		max = max or 100
		defaultValue = math.clamp(defaultValue or min, min, max)

		local container = Instance.new("Frame")
		container.Size = UDim2.new(1, 0, 0, 54)
