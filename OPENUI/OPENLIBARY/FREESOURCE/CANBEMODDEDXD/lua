-- === SAFE ICON LIBRARY LOAD ===
local IconLibraryURL = "https://raw.githubusercontent.com/Footagesus/Icons/main/Main-v2.lua"
local IconLibrary = nil
do
	local ok, result = pcall(function()
		local source = game:HttpGet(IconLibraryURL)
		local chunk = loadstring(source)
		assert(chunk, "loadstring returned nil")
		return chunk()
	end)
	if ok and type(result) == "table" then
		IconLibrary = result
		pcall(function()
			if IconLibrary.SetIconsType then IconLibrary.SetIconsType("lucide") end
		end)
	else
		warn("[GAeroUI] Icon library failed to load:", result)
	end
end

local Library = {}
Library.__index = Library

function LoadLucideIcon(iconName, parent, color)
	if not iconName or not parent then return nil end

	local iconData
	if IconLibrary and IconLibrary.Icon then
		local ok, result = pcall(IconLibrary.Icon, iconName, nil, true)
		if ok then iconData = result end
	end

	local iconLabel = Instance.new("ImageLabel")
	iconLabel.Name = "Icon"
	iconLabel.Size = UDim2.new(1, 0, 1, 0)
	iconLabel.BackgroundTransparency = 1
	iconLabel.ImageColor3 = color or Color3.fromRGB(255, 255, 255)
	iconLabel.ScaleType = Enum.ScaleType.Fit
	iconLabel.Parent = parent

	if iconData and iconData[1] then
		iconLabel.Image = iconData[1]
		if iconData[2] then
			iconLabel.ImageRectSize = iconData[2].ImageRectSize
			iconLabel.ImageRectOffset = iconData[2].ImageRectPosition
		end
	else
		iconLabel.Image = "rbxassetid://7733960981"
	end

	return iconLabel
end

