		selLbl.TextSize = 13
		selLbl.Font = Enum.Font.GothamMedium
		selLbl.TextXAlignment = Enum.TextXAlignment.Left
		selLbl.Parent = db

		local arrow = Instance.new("TextLabel")
		arrow.Size = UDim2.new(0, 24, 1, 0)
		arrow.Position = UDim2.new(1, -28, 0, 0)
		arrow.BackgroundTransparency = 1
		arrow.Text = "▼"
		arrow.TextColor3 = Theme.TextSecondary
		arrow.TextSize = 10
		arrow.Font = Enum.Font.GothamBold
		arrow.Parent = db

		local optionsList = Instance.new("ScrollingFrame")
		optionsList.Name = "OptionsList_" .. text
		optionsList.Size = UDim2.new(0, 0, 0, 0)
		optionsList.BackgroundColor3 = Color3.fromRGB(16, 16, 24)
		optionsList.BorderSizePixel = 0
		optionsList.ScrollBarThickness = 5
		optionsList.ScrollBarImageColor3 = Theme.AccentColor
		optionsList.Visible = false
		optionsList.ZIndex = 10000
		optionsList.Active = true
		optionsList.ClipsDescendants = true
		optionsList.Parent = self.Window.ScreenGui

		local listStroke = Instance.new("UIStroke")
		listStroke.Color = Theme.AccentColor
		listStroke.Transparency = 0.6
		listStroke.Thickness = 1.5
		listStroke.Parent = optionsList

		local listCorner = Instance.new("UICorner")
		listCorner.CornerRadius = UDim.new(0, 10)
		listCorner.Parent = optionsList

		local listLayout = Instance.new("UIListLayout")
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Padding = UDim.new(0, 4)
		listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		listLayout.Parent = optionsList

		local listPad = Instance.new("UIPadding")
		listPad.PaddingLeft = UDim.new(0, 8)
		listPad.PaddingRight = UDim.new(0, 8)
		listPad.PaddingTop = UDim.new(0, 8)
		listPad.PaddingBottom = UDim.new(0, 8)
		listPad.Parent = optionsList

		local scrollConnection = nil
		local closeDropdown

		local function updateOptions(newOptions)
			for _, child in pairs(optionsList:GetChildren()) do
				if child:IsA("TextButton") then child:Destroy() end
			end
			for i, option in ipairs(newOptions) do
				local ob = Instance.new("TextButton")
				ob.Size = UDim2.new(1, 0, 0, 36)
				ob.BackgroundColor3 = Color3.fromRGB(22, 22, 34)
				ob.BorderSizePixel = 0
				ob.Text = ""
				ob.AutoButtonColor = false
				ob.ZIndex = 1001
				ob.Parent = optionsList

				local obc = Instance.new("UICorner")
				obc.CornerRadius = UDim.new(0, 8)
				obc.Parent = ob

				local ot = Instance.new("TextLabel")
				ot.Size = UDim2.new(1, -24, 1, 0)
				ot.Position = UDim2.new(0, 14, 0, 0)
				ot.BackgroundTransparency = 1
				ot.Text = tostring(option)
				ot.TextColor3 = Theme.TextColor
				ot.TextSize = 13
				ot.Font = Enum.Font.GothamMedium
				ot.TextXAlignment = Enum.TextXAlignment.Left
				ot.ZIndex = 1002
				ot.Parent = ob

				local ind = Instance.new("Frame")
				ind.Size = UDim2.new(0, 3, 0, 20)
				ind.Position = UDim2.new(0, 4, 0.5, -10)
				ind.BackgroundColor3 = Theme.AccentColor
				ind.BorderSizePixel = 0
				ind.Visible = (tostring(option) == tostring(selectedValue))
				ind.ZIndex = 1002
				ind.Parent = ob

				ob.MouseButton1Click:Connect(function()
					selectedValue = option
					selLbl.Text = tostring(option)
					for _, c2 in pairs(optionsList:GetChildren()) do
						if c2:IsA("TextButton") then
							local i2 = c2:FindFirstChild("SelectionIndicator")
							if i2 then i2.Visible = false end
						end
					end
					ind.Visible = true
					closeDropdown()
					if callback then task.spawn(function() pcall(callback, option) end) end
				end)
				ob.MouseEnter:Connect(function()
					CreateTween(ob, {BackgroundColor3 = Theme.AccentColor})
				end)
				ob.MouseLeave:Connect(function()
					CreateTween(ob, {BackgroundColor3 = Color3.fromRGB(22, 22, 34)})
				end)
			end
			optionsList.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 16)
		end

		closeDropdown = function()
			isOpen = false
			CreateTween(optionsList, {Size = UDim2.new(0, optionsList.AbsoluteSize.X, 0, 0)}, TweenPresets.Medium)
			CreateTween(arrow, {Rotation = 0}, TweenPresets.Medium)
			CreateTween(db, {BackgroundColor3 = Theme.ToggleOff})
			task.wait(0.3)
			optionsList.Visible = false
			if scrollConnection then
				scrollConnection:Disconnect()
				scrollConnection = nil
			end
		end

		updateOptions(options)

		db.MouseButton1Click:Connect(function()
			isOpen = not isOpen
			if isOpen then
				local viewportSize = workspace.CurrentCamera.ViewportSize
				local ap = container.AbsolutePosition
				local as = container.AbsoluteSize
				local bottomY = ap.Y + as.Y
				local avail = math.min(280, math.max(120, viewportSize.Y - bottomY - 40))
				local contentH = math.min(#options * 40 + 16, avail)
				optionsList.Position = UDim2.new(0, ap.X + 16, 0, bottomY + 4)
				optionsList.Size = UDim2.new(0, as.X - 32, 0, 0)
				optionsList.Visible = true
				CreateTween(optionsList, {Size = UDim2.new(0, as.X - 32, 0, contentH)}, TweenPresets.Medium)
				CreateTween(arrow, {Rotation = 180}, TweenPresets.Medium)
				CreateTween(db, {BackgroundColor3 = Color3.fromRGB(50, 50, 70)})

				if scrollConnection then scrollConnection:Disconnect() end
				local contentScrollRef = self.Window.ContentScroll
				if contentScrollRef and contentScrollRef:IsA("ScrollingFrame") then
					scrollConnection = contentScrollRef:GetPropertyChangedSignal("CanvasPosition"):Connect(closeDropdown)
				end
			else
				closeDropdown()
