			SetColor = function(c, a)
				currentColor = c
				preview.BackgroundColor3 = c
				if hasTransparency and a then
					currentTransparency = a
					preview.BackgroundTransparency = a
				end
				if callback then pcall(callback, c, a or currentTransparency) end
			end,
			GetColor = function() return currentColor, currentTransparency end
		}
	end

