        Text = "", AutoButtonColor = false, Parent = card })
    area.MouseButton1Click:Connect(function() if not hasActions then dismiss() end end)
    xBtn.MouseButton1Click:Connect(function() Sfx.Pop(); dismiss() end)

    local count = 1
    function obj.bump()
        if gone then return end
        count += 1; countLbl.Text = "x"..count; countBadge.Visible = true; startProg(dur)
    end
    toastByKey[key] = obj
    table.insert(toastList, dismiss)
    if #toastList > 5 then toastList[1]() end

    Sfx.Notify(kind)
    TW(wrap, 0.3, { Size = UDim2.fromOffset(TOAST_W,h) })
    task.delay(0.08, function()
        if gone then return end
        TW(card, 0.55, { Position = UDim2.fromOffset(0,0), GroupTransparency = 0 }, Enum.EasingStyle.Back)
        TW(cardScale, 0.55, { Scale = 1 }, Enum.EasingStyle.Back)
        task.delay(0.12, function() TW(badgeScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back) end)
    end)
    startProg(dur)
end

function SZK:Notify(cfg)
