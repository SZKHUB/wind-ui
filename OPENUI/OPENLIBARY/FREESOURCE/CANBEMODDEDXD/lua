		img.Image = image
		img.ScaleType = Enum.ScaleType.Crop
		img.Parent = container
		local ic = Instance.new("UICorner"); ic.CornerRadius = UDim.new(0, radius); ic.Parent = img

		task.wait()
		local w = container.AbsoluteSize.X
		if w > 0 then
			container.Size = UDim2.new(1, 0, 0, w * (rh / rw))
			img.Size = UDim2.new(1, 0, 1, 0)
		end

		add(container, "Image")
		return {Container = container, SetImage = function(i) img.Image = i end}
	end

