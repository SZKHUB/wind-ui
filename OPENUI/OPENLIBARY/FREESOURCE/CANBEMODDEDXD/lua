        local bg = New("Frame", { Size = UDim2.fromScale(1,1), BackgroundTransparency = 0.8,
            BackgroundColor3 = T.card, Parent = holder })
        Cor(bg, 10)
        local bgScale = New("UIScale", { Parent = bg })
        local stroke = New("UIStroke", { Color = T.border, Thickness = 1.5, Transparency = 0.6,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = bg })
        local bar = New("Frame", { AnchorPoint = Vector2.new(0,0.5), Position = UDim2.new(0,5,0.5,0),
            Size = UDim2.fromOffset(3,4), BackgroundTransparency = 1,
            Theme = { BackgroundColor3 = "acc" }, Parent = bg })
        Circle(bar)
        local icon, iconProp = Icon(iconName or "circle", 20, T.muted, glyph or "•")
        icon.AnchorPoint = Vector2.new(0,0.5); icon.Position = UDim2.new(0,16,0.5,0); icon.ZIndex = 2; icon.Parent = bg
        local txt = New("TextLabel", { Size = UDim2.new(1,-52,1,0), Position = UDim2.new(0,44,0,0),
            BackgroundTransparency = 1, Text = name, TextColor3 = T.muted,
            Font = Enum.Font.GothamBold, TextSize = FONT, TextTruncate = Enum.TextTruncate.AtEnd,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = bg })

        Tabs[name] = { bg = bg, stroke = stroke, icon = icon, iconProp = iconProp, txt = txt, page = page, bar = bar }

        holder.MouseEnter:Connect(function() if currentTab ~= name then TW(bg, 0.15, { BackgroundTransparency = 0.6 }) end end)
        holder.MouseLeave:Connect(function()
            TW(bgScale, 0.2, { Scale = 1 })
            if currentTab ~= name then TW(bg, 0.2, { BackgroundTransparency = 0.8 }) end
        end)
        holder.InputBegan:Connect(function(i) if isPress(i) then Sfx.Pop(); TW(bgScale, 0.1, { Scale = 0.95 }) end end)
        holder.InputEnded:Connect(function(i) if isPress(i) then TW(bgScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back) end end)
        holder.MouseButton1Click:Connect(function() setActive(name, true) end)

        local api = {}
        local order = 0
        local function nextOrder() order += 1; return order end

        local function buildCard(h)
            local f = New("Frame", { Size = UDim2.new(1,0,0,h), BackgroundTransparency = 0.85,
                LayoutOrder = nextOrder(), Theme = { BackgroundColor3 = "card" }, Parent = page })
            Cor(f, 9); Stk(f, "edge", 1, 0.72)
            return f
        end

        local function makeSection(title)
            local section = {}
            if title and title ~= "" then
                New("TextLabel", { Size = UDim2.new(1,0,0,22), BackgroundTransparency = 1,
                    Text = string.upper(tostring(title)), Font = Enum.Font.GothamBold,
                    TextSize = FONT-1, TextXAlignment = Enum.TextXAlignment.Left,
                    LayoutOrder = nextOrder(), Theme = { TextColor3 = "acc" }, Parent = page })
            end
            local function rowLabel(parent, text, width)
                return New("TextLabel", { Size = UDim2.new(width or 1,-20,0,36), Position = UDim2.new(0,12,0,0),
                    BackgroundTransparency = 1, Text = text, Font = Enum.Font.GothamBold,
                    TextSize = FONT, TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd, Theme = { TextColor3 = "text" }, Parent = parent })
            end

            function section:CreateToggle(c)
                c = c or {}
                local name = c.Name or c.Title or "Toggle"
                local default = c.Default; if default == nil then default = c.Value or false end
                local cb = c.Callback or function() end
                local flag = c.Flag
                if flag and SZK.Flags[flag] ~= nil then default = SZK.Flags[flag] end
                local h = (c.Desc and c.Desc ~= "") and 78 or 36
                local row = buildCard(h)
                if not c.Desc or c.Desc == "" then
                    rowLabel(row, name)
                else
                    rowLabel(row, name).Position = UDim2.new(0,12,0,8)
                    New("TextLabel", { Size = UDim2.new(1,-24,0,28), Position = UDim2.new(0,12,0,34),
                        BackgroundTransparency = 1, Text = c.Desc, Font = Enum.Font.Gotham, TextSize = FONT-1,
                        TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Left,
                        TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Parent = row })
                end
                local hit = RowHit(row)
                local track = New("Frame", { AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-10,0.5,0),
                    Size = UDim2.fromOffset(40,22), Parent = row })
                Circle(track)
                local tStk = New("UIStroke", { Thickness = 1.2, Color = T.border, Parent = track })
                local knob = New("Frame", { AnchorPoint = Vector2.new(0,0.5), Size = UDim2.fromOffset(16,16),
                    BackgroundColor3 = WHITE, Parent = track })
                Circle(knob)
                local state = default
                if flag then SZK.Flags[flag] = state end
                local function paint(anim)
                    local t = anim and 0.25 or 0
                    TW(track, t, { BackgroundColor3 = state and T.acc or T.panel,
                        BackgroundTransparency = state and 0.1 or 0.35 })
                    TW(tStk, t, { Color = state and T.acc or T.border })
                    TW(knob, t, { Position = UDim2.new(0, state and 21 or 3, 0.5, 0),
                        BackgroundColor3 = state and WHITE or T.muted }, Enum.EasingStyle.Back)
                end
                paint(false)
                table.insert(onTheme, function() paint(true) end)
                hit.MouseButton1Click:Connect(function()
                    state = not state
                    if flag then SZK.Flags[flag] = state end
                    paint(true); safe(cb, state)
                end)
                local obj = {}
                function obj:Set(v) state = v and true or false; if flag then SZK.Flags[flag] = state end; paint(true); safe(cb, state) end
                function obj:Get() return state end
                return obj
            end

            function section:CreateSlider(c)
                c = c or {}
                local name = c.Name or c.Title or "Slider"
                local mn, mx = c.Min or 0, c.Max or 100
                local default = c.Default or c.Value or mn
                local cb = c.Callback or function() end
                local suffix = c.Suffix or ""
                local step = c.Step or 1
                local value = math.clamp(default, mn, mx)
                local row = buildCard(54)
                local lbl = rowLabel(row, name); lbl.Size = UDim2.new(0.7,-12,0,30)
                local function fmt(v) return tostring(math.floor(v*1000+0.5)/1000)..suffix end
                local valLbl = New("TextLabel", { AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,-12,0,0),
                    Size = UDim2.fromOffset(70,30), BackgroundTransparency = 1, Text = fmt(value),
                    Font = Enum.Font.GothamBold, TextSize = FONT, TextXAlignment = Enum.TextXAlignment.Right,
                    Theme = { TextColor3 = "acc" }, Parent = row })
                local hit = New("TextButton", { Position = UDim2.new(0,12,0,30), Size = UDim2.new(1,-24,0,20),
                    BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = row })
                local bar = New("Frame", { AnchorPoint = Vector2.new(0,0.5), Position = UDim2.new(0,0,0.5,0),
                    Size = UDim2.new(1,0,0,6), BackgroundTransparency = 0.35,
                    Theme = { BackgroundColor3 = "panel" }, Parent = hit })
                Circle(bar)
                local rel0 = (mx-mn) == 0 and 0 or (value-mn)/(mx-mn)
                local fill = New("Frame", { Size = UDim2.fromScale(rel0,1),
                    Theme = { BackgroundColor3 = "acc" }, Parent = bar })
                Circle(fill)
                local knob = New("Frame", { AnchorPoint = Vector2.new(0.5,0.5),
                    Position = UDim2.new(rel0,0,0.5,0), Size = UDim2.fromOffset(14,14),
                    BackgroundColor3 = WHITE, ZIndex = 3, Parent = bar })
                Circle(knob); New("UIStroke", { Theme = { Color = "acc" }, Thickness = 2, Parent = knob })
                local function render(rel, a)
                    if a then
                        TW(fill, 0.2, { Size = UDim2.fromScale(rel,1) })
                        TW(knob, 0.2, { Position = UDim2.new(rel,0,0.5,0) })
                    else
                        fill.Size = UDim2.fromScale(rel,1); knob.Position = UDim2.new(rel,0,0.5,0)
                    end
                end
                local function apply(v, a, silent)
                    v = math.clamp(v, mn, mx)
                    local rel = (mx-mn) == 0 and 0 or (v-mn)/(mx-mn)
                    render(rel, a)
                    if v ~= value then
                        value = v; valLbl.Text = fmt(v)
                        if not silent then safe(cb, v) end
                    end
                end
                local function fromX(x)
                    local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
                    apply(mn + math.floor((mx-mn)*rel/step + 0.5)*step, false)
                end
                local dragging = false
                hit.InputBegan:Connect(function(i)
                    if isPress(i) then
                        dragging = true; page.ScrollingEnabled = false; Sfx.Pop()
                        TW(knob, 0.15, { Size = UDim2.fromOffset(19,19) }, Enum.EasingStyle.Back)
                        fromX(i.Position.X)
                    end
                end)
                Track(UserInputService.InputChanged:Connect(function(i) if dragging and isMove(i) then fromX(i.Position.X) end end))
                Track(UserInputService.InputEnded:Connect(function(i)
                    if dragging and isPress(i) then
                        dragging = false; page.ScrollingEnabled = true
                        TW(knob, 0.2, { Size = UDim2.fromOffset(14,14) }, Enum.EasingStyle.Back); Sfx.Tick()
                    end
                end))
                local obj = {}
                function obj:Get() return value end
                function obj:Set(v) apply(v, true) end
                return obj
            end

            function section:CreateButton(c)
                c = c or {}
                local name = c.Name or c.Title or "Button"
                local cb = c.Callback or function() end
                local h = c.Description and 56 or 36
                local holderF = New("Frame", { Size = UDim2.new(1,0,0,h), BackgroundTransparency = 1,
                    LayoutOrder = nextOrder(), Parent = page })
                local b = New("TextButton", { Size = UDim2.fromScale(1,1), Text = name,
                    Font = Enum.Font.GothamBold, TextSize = FONT, AutoButtonColor = false,
                    BackgroundTransparency = 0.12,
                    Theme = { BackgroundColor3 = "acc", TextColor3 = "bg" }, Parent = holderF })
                Cor(b, 9)
                New("UIGradient", { Color = ColorSequence.new(WHITE, Color3.fromRGB(200,200,200)),
                    Rotation = 90, Parent = b })
                Interact(b, { ripple = true, hoverT = 0.0 })
                if c.Description then
                    New("TextLabel", { Position = UDim2.new(0,0,1,-16), Size = UDim2.new(1,0,0,14),
                        BackgroundTransparency = 1, Text = c.Description, Font = Enum.Font.Gotham,
                        TextSize = FONT-2, TextColor3 = T.bg, TextXAlignment = Enum.TextXAlignment.Center, Parent = b })
                end
                b.MouseButton1Click:Connect(function() safe(cb) end)
                local obj = {}
                function obj:Set(t) b.Text = tostring(t) end
                return obj
            end

            function section:CreateDropdown(c)
                c = c or {}
                local name = c.Name or c.Title or "Dropdown"
                local options = c.Options or {}
                local default = c.Default or c.Value
                local cb = c.Callback or function() end
                local flag = c.Flag
                local selected = default
                if flag and SZK.Flags[flag] ~= nil then selected = SZK.Flags[flag] end
                local row = buildCard(36); row.ClipsDescendants = true
                local hit = RowHit(row); hit.Size = UDim2.new(1,0,0,36)
                rowLabel(row, name, 0.5)
                local valLbl = New("TextLabel", { AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,-34,0,0),
                    Size = UDim2.new(0.5,-40,0,36), BackgroundTransparency = 1,
                    Text = tostring(selected or "Select"), Font = Enum.Font.GothamBold, TextSize = FONT,
                    TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd,
                    Theme = { TextColor3 = "acc" }, Parent = row })
                local chev, chevProp = Icon("chevron-down", 16, T.muted, "v")
                chev.AnchorPoint = Vector2.new(0.5,0.5); chev.Position = UDim2.new(1,-18,0,18); chev.Parent = row
                Bind(chev, chevProp, "muted")
                local listF = New("ScrollingFrame", { Position = UDim2.fromOffset(6,42), Size = UDim2.new(1,-12,0,0),
                    BackgroundTransparency = 1, ScrollBarThickness = 2, CanvasSize = UDim2.new(),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = row })
                List(listF, 4)
                local open, openH, btns = false, 36, {}
                local function refreshSel()
                    for n, b in pairs(btns) do
                        local on = (n == selected)
                        b.btn.TextColor3 = on and T.acc or T.text
                        b.st.Color = on and T.acc or T.border
                        b.st.Transparency = on and 0.1 or 0.6
                    end
                end
                table.insert(onTheme, refreshSel)
                local function setOpen(v)
                    open = v
                    TW(row, 0.3, { Size = UDim2.new(1,0,0,v and openH or 36) })
                    TW(chev, 0.3, { Rotation = v and 180 or 0 })
                end
                local function choose(n, silent)
                    selected = n; valLbl.Text = tostring(n); refreshSel()
                    if flag then SZK.Flags[flag] = n end
                    if not silent then safe(cb, n) end
                end
                local function build()
                    for _, b in pairs(btns) do b.btn:Destroy() end
                    btns = {}
                    for i, n in ipairs(options) do
                        local b = New("TextButton", { Size = UDim2.new(1,-4,0,26), LayoutOrder = i,
                            BackgroundTransparency = 0.7, Text = tostring(n), Font = Enum.Font.GothamMedium,
                            TextSize = FONT, TextColor3 = T.text,
                            Theme = { BackgroundColor3 = "panel" }, Parent = listF })
                        Cor(b, 7)
                        local st = Stk(b, "border", 1, 0.6)
                        Interact(b, { ripple = true, scale = false })
                        b.MouseButton1Click:Connect(function() choose(n); setOpen(false) end)
                        btns[n] = { btn = b, st = st }
                    end
                    local vis = math.min(#options, 5)
                    local lh = vis*26 + math.max(vis-1,0)*4
                    listF.Size = UDim2.new(1,-12,0,lh)
                    openH = 36 + 6 + lh + 8
                    refreshSel()
                    if open then row.Size = UDim2.new(1,0,0,openH) end
                end
                build()
                hit.MouseButton1Click:Connect(function() setOpen(not open) end)
                local obj = {}
                function obj:Get() return selected end
                function obj:Set(v, silent) choose(v, silent) end
                function obj:Refresh(opts) options = opts or {}; build() end
                return obj
            end

            function section:CreateInput(c)
                c = c or {}
                local name = c.Name or c.Title or "Input"
                local default = c.Default or c.Value or ""
                local cb = c.Callback or function() end
                local row = buildCard(36)
                rowLabel(row, name, 0.5)
                local box = New("TextBox", { AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-8,0.5,0),
                    Size = UDim2.new(0.5,-12,0,24), BackgroundTransparency = 0.55,
                    PlaceholderText = c.Placeholder or "Type here...", Text = default,
                    ClearTextOnFocus = false, Font = Enum.Font.Gotham, TextSize = FONT,
                    TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
                    Theme = { BackgroundColor3 = "panel", TextColor3 = "text",
                        PlaceholderColor3 = "muted" }, Parent = row })
                Cor(box, 7); Pad(box, 0,0,8,8)
                local st = Stk(box, "border", 1, 0.5)
                box.Focused:Connect(function() Sfx.Pop(); TW(st, 0.2, { Color = T.acc, Transparency = 0 }) end)
                box.FocusLost:Connect(function(enter)
                    TW(st, 0.2, { Color = T.border, Transparency = 0.5 })
                    safe(cb, box.Text, enter)
                end)
                local obj = {}
                function obj:Get() return box.Text end
                function obj:Set(t) box.Text = tostring(t) end
                return obj
            end

            function section:CreateKeybind(c)
                c = c or {}
                local name = c.Name or c.Title or "Keybind"
                local key = c.Default or c.Value
                local cb = c.Callback or function() end
                local row = buildCard(36)
                rowLabel(row, name, 0.6)
                local btn = New("TextButton", { AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-8,0.5,0),
                    Size = UDim2.fromOffset(96,24), Text = key and key.Name or "None",
                    Font = Enum.Font.GothamBold, TextSize = FONT, BackgroundTransparency = 0.55,
                    Theme = { BackgroundColor3 = "panel", TextColor3 = "acc" }, Parent = row })
                Cor(btn, 7); Stk(btn, "border", 1, 0.5)
                Interact(btn, { ripple = true, press = 0.94 })
                local listening = false
                btn.MouseButton1Click:Connect(function() listening = true; btn.Text = "..." end)
                Track(UserInputService.InputBegan:Connect(function(i, gp)
                    if listening then
                        if i.UserInputType == Enum.UserInputType.Keyboard then
                            listening = false
                            if i.KeyCode ~= Enum.KeyCode.Escape then key = i.KeyCode end
                            btn.Text = key and key.Name or "None"; Sfx.Tick()
                        end
                    elseif key and not gp and i.KeyCode == key then safe(cb, key) end
                end))
                local obj = {}
                function obj:Get() return key end
                function obj:Set(k) key = k; btn.Text = k and k.Name or "None" end
                return obj
            end

            function section:CreateLabel(text)
                local row = New("Frame", { Size = UDim2.new(1,0,0,26), BackgroundTransparency = 1,
                    LayoutOrder = nextOrder(), Parent = page })
                local l = New("TextLabel", { Size = UDim2.new(1,-12,1,0), Position = UDim2.new(0,12,0,0),
                    BackgroundTransparency = 1, Text = tostring(text), Font = Enum.Font.Gotham,
                    TextSize = FONT, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
                local obj = {}
                function obj:Set(t) l.Text = tostring(t) end
                return obj
            end

            function section:CreateParagraph(title, body)
                if type(title) == "table" then
                    body = title.Body or title.Text
                    title = title.Title or title.Name
                end
                local c2 = buildCard(0); c2.AutomaticSize = Enum.AutomaticSize.Y
                Pad(c2, 9,10,12,12); List(c2, 4)
                New("TextLabel", { Size = UDim2.new(1,0,0,18), BackgroundTransparency = 1,
                    Text = title or "", Font = Enum.Font.GothamBold, TextSize = FONT,
                    TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1,
                    Theme = { TextColor3 = "text" }, Parent = c2 })
                local b = New("TextLabel", { Size = UDim2.new(1,0,0,0), AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1, Text = body or "", Font = Enum.Font.Gotham, TextSize = FONT,
                    TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2,
                    Theme = { TextColor3 = "muted" }, Parent = c2 })
                local obj = {}
                function obj:Set(t) b.Text = tostring(t) end
                return obj
            end

            function section:CreateDivider()
                New("Frame", { Size = UDim2.new(1,0,0,1), BackgroundTransparency = 0.7,
                    LayoutOrder = nextOrder(), Theme = { BackgroundColor3 = "edge" }, Parent = page })
            end

            function section:CreateProgressBar(c)
                c = c or {}
                local name = c.Name or c.Title or "Progress"
                local mn, mx = c.Min or 0, c.Max or 100
                local value = c.Default or c.Value or mn
                local row = buildCard(48)
                rowLabel(row, name).Size = UDim2.new(0.7,-12,0,30)
                local pct = New("TextLabel", { AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,-12,0,0),
                    Size = UDim2.fromOffset(60,30), BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
                    TextSize = FONT, TextXAlignment = Enum.TextXAlignment.Right,
                    Theme = { TextColor3 = "acc" }, Parent = row })
                local track = New("Frame", { Position = UDim2.new(0,12,0,32), Size = UDim2.new(1,-24,0,6),
                    BackgroundTransparency = 0.35, Theme = { BackgroundColor3 = "panel" }, Parent = row })
                Circle(track)
                local fill = New("Frame", { Size = UDim2.fromScale(0,1),
                    Theme = { BackgroundColor3 = "acc" }, Parent = track })
                Circle(fill)
                local function redraw(a)
                    local t = math.clamp((value-mn)/math.max(mx-mn,1), 0, 1)
                    if a then TW(fill, 0.25, { Size = UDim2.fromScale(t,1) }) else fill.Size = UDim2.fromScale(t,1) end
                    pct.Text = math.floor(t*100).."%"
                end
                redraw(false)
                local obj = {}
                function obj:Set(v) value = math.clamp(v, mn, mx); redraw(true) end
                function obj:Get() return value end
                return obj
            end

            function section:CreateBanner(c)
                c = c or {}
                local row = buildCard(c.Height or 120)
                row.ClipsDescendants = true
                if c.Image then
                    local src = c.Image
                    if type(src) == "string" and SZK.Icons[src] then src = SZK.Icons[src] end
                    if type(src) == "number" then src = "rbxassetid://"..src end
                    New("ImageLabel", { Size = UDim2.fromScale(1,1), BackgroundTransparency = 1,
                        Image = src, ScaleType = Enum.ScaleType.Crop, Parent = row })
                end
            end

            function section:CreateHero(c)
                c = c or {}
                local row = buildCard(c.Height or 176)
                Pad(row, 16,16,16,16); List(row, 6)
                New("TextLabel", { Size = UDim2.new(1,0,0,22), BackgroundTransparency = 1,
                    Text = c.Title or c.Name or "", Font = Enum.Font.GothamBold, TextSize = FONT_TITLE,
                    TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1,
                    Theme = { TextColor3 = "text" }, Parent = row })
                New("TextLabel", { Size = UDim2.new(1,0,0,0), AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1, Text = c.Content or c.Description or "",
                    Font = Enum.Font.Gotham, TextSize = FONT, TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
                    LayoutOrder = 2, Theme = { TextColor3 = "muted" }, Parent = row })
            end

            return section
        end

        function api:CreateSection(t) return makeSection(t) end
        function api:CreateToggle(...)       return makeSection(""):CreateToggle(...) end
        function api:CreateSlider(...)       return makeSection(""):CreateSlider(...) end
        function api:CreateButton(...)       return makeSection(""):CreateButton(...) end
        function api:CreateDropdown(...)     return makeSection(""):CreateDropdown(...) end
        function api:CreateInput(...)        return makeSection(""):CreateInput(...) end
        function api:CreateKeybind(...)      return makeSection(""):CreateKeybind(...) end
        function api:CreateLabel(...)        return makeSection(""):CreateLabel(...) end
        function api:CreateParagraph(...)    return makeSection(""):CreateParagraph(...) end
        function api:CreateDivider(...)      return makeSection(""):CreateDivider(...) end
        function api:CreateBanner(...)       return makeSection(""):CreateBanner(...) end
        function api:CreateHero(...)         return makeSection(""):CreateHero(...) end
        function api:CreateProgressBar(...)  return makeSection(""):CreateProgressBar(...) end
        api.Page = page
        return api
    end

    function Window:CreateTab(tabConfig, maybeIcon)
        local cfgT = type(tabConfig) == "table" and tabConfig or nil
        local tabName, tabIcon
        if cfgT then tabName = cfgT.Name or cfgT.Title or "Tab"; tabIcon = cfgT.Icon
        else tabName = tabConfig or "Tab"; tabIcon = maybeIcon end
        return AddTab(tabName, tabIcon)
    end
    Window.AddTab = AddTab

    function Window:SetTheme(name) applyThemeByName(name) end
    function Window:SetTitle(t) titleLabel.Text = tostring(t or "") end
    function Window:SetSize(v)
        if typeof(v) == "Vector2" then
            winW, winH = v.X, v.Y
            win.Size = UDim2.fromOffset(winW, winH)
            shell.Size = UDim2.fromOffset(winW+40, winH+40)
            fitWindow()
        end
    end
    function Window:Minimize() if winOpen then toggleWindow() end end
    function Window:Restore() if not winOpen then toggleWindow() end end
    function Window:Destroy()
        for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
        if winOpen then
            openWindows = math.max(0, openWindows - 1)
            updateBlurState()
        end
        for i, w in ipairs(SZK.Windows) do if w == self then table.remove(SZK.Windows, i) break end end
        pcall(function() GUI:Destroy() end)
        pcall(function() BtnGui:Destroy() end)
    end

    -- Heartbeat
    do
        local t = 0
        Track(RunService.Heartbeat:Connect(function(dt)
            if not alive then return end
            t += math.min(dt, 0.1)
            pillGrad.Rotation = (t * 90) % 360
        end))
    end

    applyThemeByName(themeName, true)
    toggleWindow()
    table.insert(SZK.Windows, Window)
    return Window
end

SZK.New = SZK.CreateWindow
SZK.Window = SZK.CreateWindow

